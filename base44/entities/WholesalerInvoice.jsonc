{
  "name": "WholesalerInvoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero visible de la factura consolidada (FM-AAAAMMDD-###)"
    },
    "billing_mode": {
      "type": "string",
      "enum": [
        "contenedores",
        "manual"
      ],
      "default": "contenedores",
      "description": "contenedores: armada desde las \u00f3rdenes del cliente; manual: CBM y paquetes cargados a mano por cliente"
    },
    "wholesaler_key": {
      "type": "string",
      "description": "Clave de la conexi\u00f3n (WholesalerSync.config_key) del mayorista al que pertenece la factura"
    },
    "wholesaler_name": {
      "type": "string"
    },
    "invoice_email": {
      "type": "string",
      "description": "Correo del mayorista al que se envi\u00f3 esta factura"
    },
    "emitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "emitted_by": {
      "type": "string"
    },
    "clients": {
      "type": "array",
      "default": [],
      "description": "Detalle por cliente incluido en la factura, con las tarifas y montos congelados al emitir",
      "items": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_email": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "shipping_mark": {
            "type": "string"
          },
          "rate_per_cbm": {
            "type": "number",
            "description": "Tarifa de env\u00edo por CBM (USD/CBM), congelada al emitir"
          },
          "door_to_door_per_cbm": {
            "type": "number",
            "description": "Tarifa de puerta a puerta por CBM (USD/CBM), congelada al emitir"
          },
          "rate_per_bulto": {
            "type": "number",
            "description": "DEPRECATED: tarifa de puerta a puerta por bulto de las facturas anteriores"
          },
          "handling_fee": {
            "type": "number",
            "description": "Cargo por paquete (USD) congelado al emitir"
          },
          "bultos": {
            "type": "number"
          },
          "packages": {
            "type": "number",
            "description": "Cantidad de paquetes facturados (factura manual)"
          },
          "cbm": {
            "type": "number",
            "description": "CBM facturados"
          },
          "received_trackings": {
            "type": "number",
            "description": "Paquetes/trackings cobrados en el manejo"
          },
          "shipping_amount": {
            "type": "number"
          },
          "door_to_door_amount": {
            "type": "number"
          },
          "handling_amount": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "orders": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "order_number": {
                  "type": "string"
                },
                "cbm": {
                  "type": "number"
                },
                "bultos": {
                  "type": "number"
                },
                "trackings_count": {
                  "type": "number"
                },
                "received_trackings": {
                  "type": "number"
                },
                "trackings": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string"
                  }
                },
                "is_new": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "email_status": {
            "type": "string",
            "enum": [
              "enviado",
              "fallido",
              "omitido",
              "sin_correo",
              "pendiente"
            ]
          },
          "email_error": {
            "type": "string",
            "maxLength": 500
          },
          "email_sent_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "clients": {
          "type": "number"
        },
        "cbm": {
          "type": "number"
        },
        "bultos": {
          "type": "number"
        },
        "received_trackings": {
          "type": "number"
        },
        "shipping": {
          "type": "number"
        },
        "door_to_door": {
          "type": "number"
        },
        "handling": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      }
    },
    "emails_sent": {
      "type": "number",
      "default": 0
    },
    "emails_failed": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "enviada",
        "parcial",
        "sin_envio"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "sin_envio"
    },
    "warnings": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "invoice_number",
    "emitted_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}