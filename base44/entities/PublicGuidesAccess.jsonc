{
  "name": "PublicGuidesAccess",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "default": "main"
    },
    "access_password_hash": {
      "type": "string",
      "description": "Hash de la clave compartida del enlace p\u00fablico de gu\u00edas"
    },
    "access_password_salt": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}