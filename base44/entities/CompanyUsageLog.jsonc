{
  "name": "CompanyUsageLog",
  "type": "object",
  "properties": {
    "company_code": {
      "type": "string",
      "description": "Empresa socia que realiz\u00f3 la operaci\u00f3n por el canal de datos"
    },
    "capability": {
      "type": "string",
      "description": "Capacidad usada: lectura, escritura, funcion, archivos, configuracion, directorio o lote"
    },
    "action": {
      "type": "string",
      "description": "Operaci\u00f3n concreta (list, filter, create, update, delete, invoke, upload_private, upsert, batch\u2026)"
    },
    "entity_name": {
      "type": "string",
      "description": "Entidad afectada cuando aplica"
    },
    "function_name": {
      "type": "string",
      "description": "Funci\u00f3n de backend ejecutada cuando aplica"
    },
    "record_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de registros le\u00eddos o escritos"
    },
    "actor_email": {
      "type": "string",
      "description": "Empleado o cliente de la socia que actu\u00f3"
    },
    "actor_role": {
      "type": "string",
      "description": "Rol del actor dentro de la app de la socia"
    },
    "success": {
      "type": "boolean",
      "default": true,
      "description": "Si la operaci\u00f3n termin\u00f3 bien"
    },
    "error_message": {
      "type": "string",
      "maxLength": 500,
      "description": "Detalle del error cuando la operaci\u00f3n fall\u00f3"
    },
    "duration_ms": {
      "type": "number",
      "description": "Duraci\u00f3n de la operaci\u00f3n en milisegundos"
    },
    "source": {
      "type": "string",
      "description": "Origen de la llamada (canal de datos, app de la socia\u2026)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "company_code",
    "capability"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}