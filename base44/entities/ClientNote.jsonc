{
  "name": "ClientNote",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "note": {
      "type": "string",
      "description": "Contenido de la nota"
    },
    "created_by": {
      "type": "string",
      "description": "Email del admin que cre\u00f3 la nota"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "general",
        "payment",
        "shipping",
        "support"
      ],
      "default": "general",
      "description": "Tipo de nota"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "client_email",
    "note"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}