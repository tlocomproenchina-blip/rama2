{
  "name": "DispatchOrderSheet",
  "type": "object",
  "properties": {
    "period_from": {
      "type": "string",
      "format": "date",
      "description": "Primer d\u00eda del per\u00edodo elegido (YYYY-MM-DD, hora de Caracas)"
    },
    "period_to": {
      "type": "string",
      "format": "date",
      "description": "\u00daltimo d\u00eda del per\u00edodo elegido (YYYY-MM-DD, hora de Caracas)"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que se arm\u00f3 la orden por primera vez"
    },
    "generated_by": {
      "type": "string",
      "description": "Email del admin que arm\u00f3 la orden"
    },
    "regenerated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento de la \u00faltima regeneraci\u00f3n manual de la orden"
    },
    "regenerated_by": {
      "type": "string",
      "description": "Email del admin que regener\u00f3 la orden"
    },
    "invoice_ids": {
      "type": "array",
      "default": [],
      "description": "IDs de las facturas pagadas incluidas en el per\u00edodo",
      "items": {
        "type": "string"
      }
    },
    "invoice_numbers": {
      "type": "array",
      "default": [],
      "description": "N\u00fameros de las facturas pagadas incluidas (para buscar la orden en el historial)",
      "items": {
        "type": "string"
      }
    },
    "cities": {
      "type": "array",
      "default": [],
      "description": "Contenido de la orden agrupado por ciudad, y dentro de cada ciudad por shipping mark y N\u00b0 de orden/env\u00edo, con sus cajas consolidadas y bultos sueltos.",
      "items": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "clients_count": {
            "type": "number",
            "description": "Cantidad de clientes (shipping marks) de esa ciudad"
          },
          "cajas": {
            "type": "number",
            "description": "Cajas consolidadas de la ciudad, sin repetir una caja que aparezca en varias \u00f3rdenes"
          },
          "bultos_sueltos": {
            "type": "number"
          },
          "total_unidades": {
            "type": "number"
          },
          "packages": {
            "type": "number",
            "description": "Paquetes reales sumados de las cajas y bultos de la ciudad"
          },
          "marks": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "shipping_mark": {
                  "type": "string"
                },
                "client_name": {
                  "type": "string"
                },
                "client_email": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "cajas": {
                  "type": "number"
                },
                "bultos_sueltos": {
                  "type": "number"
                },
                "total_unidades": {
                  "type": "number"
                },
                "packages": {
                  "type": "number"
                },
                "orders": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "object",
                    "properties": {
                      "order_number": {
                        "type": "string",
                        "description": "N\u00b0 de orden/env\u00edo pagado (invoice_number de CbmIngreso) o 'Sin N\u00b0 de orden'"
                      },
                      "invoice_numbers": {
                        "type": "array",
                        "default": [],
                        "items": {
                          "type": "string"
                        },
                        "description": "Facturas pagadas que cubren esta orden"
                      },
                      "cajas": {
                        "type": "number"
                      },
                      "bultos_sueltos": {
                        "type": "number"
                      },
                      "packages": {
                        "type": "number"
                      },
                      "units": {
                        "type": "array",
                        "default": [],
                        "description": "Unidades que el almac\u00e9n debe buscar para esta orden",
                        "items": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "description": "Etiqueta del bulto o de la caja consolidada"
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "caja",
                                "bulto"
                              ],
                              "description": "caja para una caja consolidada; bulto para un bulto suelto"
                            },
                            "caja_index": {
                              "type": "string",
                              "description": "Posici\u00f3n X/N de la caja dentro del lote del cliente"
                            },
                            "package_count": {
                              "type": "number"
                            },
                            "cbm": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "code",
                            "kind"
                          ]
                        }
                      }
                    },
                    "required": [
                      "order_number"
                    ]
                  }
                }
              },
              "required": [
                "shipping_mark"
              ]
            }
          }
        },
        "required": [
          "city"
        ]
      }
    },
    "totals": {
      "type": "object",
      "description": "Totales de la orden al armarla",
      "properties": {
        "cities": {
          "type": "number"
        },
        "clients": {
          "type": "number"
        },
        "invoices": {
          "type": "number"
        },
        "orders": {
          "type": "number"
        },
        "cajas": {
          "type": "number"
        },
        "bultos_sueltos": {
          "type": "number"
        },
        "total_unidades": {
          "type": "number"
        },
        "packages": {
          "type": "number"
        }
      }
    },
    "message_text": {
      "type": "string",
      "description": "Mensaje tal como se le manda al almac\u00e9n por WhatsApp y como sale en el TXT. Se guarda para que la reimpresi\u00f3n y el reenv\u00edo salgan id\u00e9nticos."
    },
    "whatsapp_phone": {
      "type": "string",
      "description": "N\u00famero de WhatsApp del almac\u00e9n al que se envi\u00f3 esta orden"
    },
    "whatsapp_sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que el admin abri\u00f3 esta orden para mandarla por WhatsApp"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "period_from",
    "period_to",
    "generated_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}