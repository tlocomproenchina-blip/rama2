{
  "name": "WholesalerPortalLink",
  "type": "object",
  "properties": {
    "wholesaler_key": {
      "type": "string",
      "description": "Conexi\u00f3n (WholesalerSync.config_key) a la que pertenece el portal. Un enlace solo da acceso a los datos de ese mayorista."
    },
    "wholesaler_name": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Clave secreta y larga del enlace privado del portal"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se desactiva al regenerar el enlace"
    },
    "access_password_hash": {
      "type": "string",
      "description": "Hash de la contrase\u00f1a de ingreso al portal"
    },
    "access_password_salt": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "last_access_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wholesaler_key",
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}