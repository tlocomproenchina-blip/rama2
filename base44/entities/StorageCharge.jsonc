{
  "name": "StorageCharge",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "ID de la factura a la que se suman los cargos"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura (cache para mostrar)"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente que recibe el cargo"
    },
    "charge_type": {
      "type": "string",
      "enum": [
        "cargo_fijo",
        "almacenamiento_diario",
        "montacargas",
        "aviso"
      ],
      "enumColors": [
        "purple",
        "blue",
        "yellow",
        "gray"
      ],
      "description": "Tipo de registro: cargo fijo del d\u00eda 8 (USD 100), almacenamiento diario desde el d\u00eda 9 (USD 20), montacargas aplicado aparte en la factura, o aviso de fin de contrato. Los registros sin tipo son del m\u00e9todo anterior por tama\u00f1o de bulto (descontinuado)."
    },
    "charge_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha (YYYY-MM-DD) en que se registr\u00f3 el cargo"
    },
    "day_number": {
      "type": "number",
      "description": "D\u00eda del contrato cubierto por este registro (el \u00faltimo del rango cargado)"
    },
    "covered_days": {
      "type": "array",
      "default": [],
      "description": "D\u00edas del contrato incluidos en este registro",
      "items": {
        "type": "number"
      }
    },
    "days_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de d\u00edas de almacenamiento cobrados en este registro"
    },
    "units_standard": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED: bultos est\u00e1ndar del m\u00e9todo anterior por tama\u00f1o"
    },
    "units_large": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED: bultos grandes del m\u00e9todo anterior por tama\u00f1o"
    },
    "units_source": {
      "type": "string",
      "enum": [
        "bulto",
        "envio",
        "ninguna"
      ],
      "description": "De d\u00f3nde salieron las unidades en almac\u00e9n registradas como referencia"
    },
    "units_snapshot": {
      "type": "array",
      "default": [],
      "description": "Referencia de las unidades que segu\u00edan en almac\u00e9n ese d\u00eda",
      "items": {
        "type": "object",
        "properties": {
          "label_code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "pallets": {
            "type": "number"
          },
          "requires_forklift": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "daily_rate_standard": {
      "type": "number",
      "description": "DEPRECATED: tarifa diaria est\u00e1ndar del m\u00e9todo anterior"
    },
    "daily_rate_large": {
      "type": "number",
      "description": "DEPRECATED: tarifa diaria grande del m\u00e9todo anterior"
    },
    "daily_amount": {
      "type": "number",
      "default": 0,
      "description": "Monto diario de almacenamiento (0 en el cargo fijo)"
    },
    "storage_amount": {
      "type": "number",
      "default": 0,
      "description": "Almacenamiento cobrado en este registro (cargo fijo o d\u00eda de almacenamiento)"
    },
    "forklift_pallets_today": {
      "type": "number",
      "default": 0,
      "description": "Palets/usos de montacargas registrados (solo en registros de montacargas)"
    },
    "forklift_amount": {
      "type": "number",
      "default": 0,
      "description": "Recargo de montacargas aplicado en la factura (solo en registros de montacargas)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Total del registro"
    },
    "accumulated_amount": {
      "type": "number",
      "default": 0,
      "description": "Acumulado de almacenamiento incluyendo este registro"
    },
    "invoice_total_before": {
      "type": "number",
      "description": "Total de la factura antes de sumar este registro"
    },
    "invoice_total_after": {
      "type": "number",
      "description": "Total de la factura despu\u00e9s de sumar este registro"
    },
    "notified": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se avis\u00f3 al cliente de estos cargos"
    },
    "notified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se avis\u00f3 al cliente"
    },
    "created_by": {
      "type": "string",
      "description": "Qui\u00e9n registr\u00f3 el cargo: sistema (autom\u00e1tico) o el email del administrador"
    },
    "notes": {
      "type": "string",
      "description": "Notas del c\u00e1lculo"
    }
  },
  "required": [
    "invoice_id",
    "client_email",
    "day_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}