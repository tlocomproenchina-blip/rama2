{
  "name": "StorageCharge",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "ID de la factura a la que se suman los cargos"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura (cache para mostrar)"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente que recibe el cargo"
    },
    "charge_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha (YYYY-MM-DD) en que se registr\u00f3 el cargo"
    },
    "day_number": {
      "type": "number",
      "description": "D\u00eda del contrato cubierto por este registro (el \u00faltimo del rango cargado)"
    },
    "covered_days": {
      "type": "array",
      "default": [],
      "description": "D\u00edas del contrato incluidos en este registro (por ejemplo 8, 9 y 10 cuando la primera ejecuci\u00f3n regulariza d\u00edas atrasados)",
      "items": {
        "type": "number"
      }
    },
    "days_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de d\u00edas de almacenamiento cobrados en este registro"
    },
    "units_standard": {
      "type": "number",
      "default": 0,
      "description": "Bultos est\u00e1ndar cobrados en el d\u00eda"
    },
    "units_large": {
      "type": "number",
      "default": 0,
      "description": "Bultos grandes cobrados en el d\u00eda"
    },
    "units_source": {
      "type": "string",
      "enum": [
        "bulto",
        "envio",
        "ninguna"
      ],
      "description": "De d\u00f3nde salieron las unidades cobradas: bultos registrados en almac\u00e9n, env\u00edos de la factura o ninguna"
    },
    "units_snapshot": {
      "type": "array",
      "default": [],
      "description": "Snapshot de las unidades cobradas ese d\u00eda (etiqueta, categor\u00eda, palets y montacargas)",
      "items": {
        "type": "object",
        "properties": {
          "label_code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "pallets": {
            "type": "number"
          },
          "requires_forklift": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "daily_rate_standard": {
      "type": "number",
      "description": "Tarifa diaria est\u00e1ndar vigente cuando se calcul\u00f3 el registro"
    },
    "daily_rate_large": {
      "type": "number",
      "description": "Tarifa diaria grande vigente cuando se calcul\u00f3 el registro"
    },
    "daily_amount": {
      "type": "number",
      "default": 0,
      "description": "Monto diario de almacenamiento (bultos est\u00e1ndar y grandes)"
    },
    "storage_amount": {
      "type": "number",
      "default": 0,
      "description": "Almacenamiento cobrado en este registro (daily_amount \u00d7 d\u00edas cubiertos)"
    },
    "forklift_pallets_today": {
      "type": "number",
      "default": 0,
      "description": "Palets que estrenaron el recargo de montacargas en este registro"
    },
    "forklift_amount": {
      "type": "number",
      "default": 0,
      "description": "Recargo \u00fanico de montacargas cobrado en este registro"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Total del registro (almacenamiento + montacargas)"
    },
    "accumulated_amount": {
      "type": "number",
      "default": 0,
      "description": "Acumulado de almacenamiento y montacargas incluyendo este registro"
    },
    "invoice_total_before": {
      "type": "number",
      "description": "Total de la factura antes de sumar este registro"
    },
    "invoice_total_after": {
      "type": "number",
      "description": "Total de la factura despu\u00e9s de sumar este registro"
    },
    "notified": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se avis\u00f3 al cliente de estos cargos"
    },
    "notified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se avis\u00f3 al cliente"
    },
    "created_by": {
      "type": "string",
      "description": "Qui\u00e9n registr\u00f3 el cargo: sistema (autom\u00e1tico) o el email del administrador"
    },
    "notes": {
      "type": "string",
      "description": "Notas del c\u00e1lculo (unidades no ubicadas, cargos detenidos por el d\u00eda tope, etc.)"
    }
  },
  "required": [
    "invoice_id",
    "client_email",
    "day_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}