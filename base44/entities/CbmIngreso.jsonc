{
  "name": "CbmIngreso",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del registro de CBM"
    },
    "cbm": {
      "type": "number",
      "description": "Cantidad de CBM reportados"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n o referencia del ingreso"
    },
    "mes": {
      "type": "string",
      "description": "Mes en formato YYYY-MM para agrupaci\u00f3n"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor o almac\u00e9n de origen"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente asociado"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente (cache para mostrar)"
    },
    "shipping_mark": {
      "type": "string",
      "description": "Shipping mark del cliente"
    },
    "tracking_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "N\u00fameros de tracking asignados a este ingreso"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura asignado"
    },
    "fecha_salida": {
      "type": "string",
      "format": "date",
      "description": "Fecha de salida de la carga"
    },
    "fecha_estimada_llegada": {
      "type": "string",
      "format": "date",
      "description": "Fecha estimada de llegada (fecha_salida + 90 d\u00edas)"
    }
  },
  "required": [
    "fecha",
    "cbm",
    "mes"
  ]
}