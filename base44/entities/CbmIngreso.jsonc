{
  "name": "CbmIngreso",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del registro de CBM"
    },
    "cbm": {
      "type": "number",
      "description": "Cantidad de CBM reportados"
    },
    "fob_total": {
      "type": "number",
      "description": "Valor FOB total de la carga en USD"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n o referencia del ingreso"
    },
    "mes": {
      "type": "string",
      "description": "Mes en formato YYYY-MM para agrupaci\u00f3n"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor o almac\u00e9n de origen"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente asociado"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente (cache para mostrar)"
    },
    "shipping_mark": {
      "type": "string",
      "description": "Shipping mark del cliente"
    },
    "tracking_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "N\u00fameros de tracking asignados a este ingreso"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura asignado"
    },
    "billed": {
      "type": "boolean",
      "default": false,
      "description": "Si este registro ya fue incluido en una factura manual combinada"
    },
    "billed_invoice_id": {
      "type": "string",
      "description": "ID de la factura manual combinada que incluye este registro"
    },
    "fecha_salida": {
      "type": "string",
      "format": "date",
      "description": "Fecha de salida de la carga"
    },
    "fecha_estimada_llegada": {
      "type": "string",
      "format": "date",
      "description": "Fecha estimada de llegada (fecha_salida + 90 d\u00edas)"
    },
    "disponible_entrega": {
      "type": "boolean",
      "default": false,
      "description": "Carga disponible para entrega (visible para el cliente)"
    },
    "package_count": {
      "type": "number",
      "description": "Conteo real de paquetes registrado por el almac\u00e9n de Venezuela. Se refleja en el recibo para que cuadre con el bulto."
    },
    "ve_synced_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el almac\u00e9n de Venezuela (bulto) actualiz\u00f3 o cre\u00f3 este recibo: N\u00b0 de orden, CBM y conteo de paquetes."
    },
    "ve_synced_by": {
      "type": "string",
      "description": "Usuario o dispositivo del almac\u00e9n de Venezuela que dej\u00f3 alineado este recibo"
    },
    "ve_synced_bulto_label": {
      "type": "string",
      "description": "C\u00f3digo de etiqueta del bulto desde el que se aline\u00f3 este recibo"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "fecha",
    "cbm",
    "mes"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}