{
  "name": "User",
  "type": "object",
  "properties": {
    "cedula": {
      "type": "string",
      "description": "N\u00famero de c\u00e9dula del cliente"
    },
    "custom_role": {
      "type": "string",
      "enum": [
        "operaciones",
        "almacen",
        "contabilidad",
        "soporte",
        "marketing"
      ],
      "description": "Rol por \u00e1rea operativa"
    },
    "operator_code": {
      "type": "string",
      "description": "C\u00f3digo consecutivo del operador de almac\u00e9n (01, 02...). Se imprime como OP 01 en las etiquetas que env\u00eda a imprimir."
    },
    "billing_use_registration": {
      "type": "boolean",
      "default": true,
      "description": "Si la direcci\u00f3n de facturaci\u00f3n es la misma de registro"
    },
    "billing_name": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social para facturaci\u00f3n"
    },
    "billing_cedula_rif": {
      "type": "string",
      "description": "C\u00e9dula o RIF de facturaci\u00f3n"
    },
    "billing_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de facturaci\u00f3n"
    },
    "billing_address": {
      "type": "string",
      "description": "Direcci\u00f3n exacta de facturaci\u00f3n"
    },
    "billing_rif_image_url": {
      "type": "string",
      "description": "URL de la imagen del RIF subida para facturaci\u00f3n"
    },
    "origin_city": {
      "type": "string",
      "description": "Slug de la ciudad de origen (landing page desde donde se registr\u00f3 el cliente)"
    },
    "origin_city_name": {
      "type": "string",
      "description": "Nombre legible de la ciudad de origen del cliente"
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo de referidor del usuario"
    },
    "referred_by_user_id": {
      "type": "string",
      "description": "ID del usuario que lo refiri\u00f3"
    },
    "referral_joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vinculaci\u00f3n con el referidor"
    },
    "referral_code_used": {
      "type": "string",
      "description": "C\u00f3digo de referidor usado al vincularse"
    },
    "referral_first_order": {
      "type": "string",
      "description": "Primera gu\u00eda al momento de vincularse"
    }
  },
  "required": [
    "cedula"
  ]
}