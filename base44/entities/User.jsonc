{
  "name": "User",
  "type": "object",
  "properties": {
    "cedula": {
      "type": "string",
      "description": "N\u00famero de c\u00e9dula del cliente"
    },
    "custom_role": {
      "type": "string",
      "enum": [
        "operaciones",
        "almacen",
        "contabilidad",
        "soporte",
        "marketing"
      ],
      "description": "Rol por \u00e1rea operativa"
    },
    "billing_use_registration": {
      "type": "boolean",
      "default": true,
      "description": "Si la direcci\u00f3n de facturaci\u00f3n es la misma de registro"
    },
    "billing_name": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social para facturaci\u00f3n"
    },
    "billing_cedula_rif": {
      "type": "string",
      "description": "C\u00e9dula o RIF de facturaci\u00f3n"
    },
    "billing_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de facturaci\u00f3n"
    },
    "billing_address": {
      "type": "string",
      "description": "Direcci\u00f3n exacta de facturaci\u00f3n"
    },
    "billing_rif_image_url": {
      "type": "string",
      "description": "URL de la imagen del RIF subida para facturaci\u00f3n"
    },
    "origin_city": {
      "type": "string",
      "description": "Slug de la ciudad de origen (landing page desde donde se registr\u00f3 el cliente)"
    },
    "origin_city_name": {
      "type": "string",
      "description": "Nombre legible de la ciudad de origen del cliente"
    },
    "origin_app_id": {
      "type": "string",
      "description": "ID de la app integrada (IntegratedApp) que registr\u00f3 este cliente desde una copia. Vac\u00edo = registrado directamente en TLEC CARGO o cliente de la maestra."
    },
    "origin_app_label": {
      "type": "string",
      "description": "Nombre de la app integrada que origin\u00f3 el registro (cache para mostrar)"
    }
  },
  "required": [
    "cedula"
  ]
}