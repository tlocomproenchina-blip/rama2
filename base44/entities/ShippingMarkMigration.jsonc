{
  "name": "ShippingMarkMigration",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del cliente migrado"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente al momento de migrar"
    },
    "old_mark": {
      "type": "string",
      "description": "Shipping Mark anterior (serie 50000+)"
    },
    "new_mark": {
      "type": "string",
      "description": "Shipping Mark nuevo (serie 5000)"
    },
    "new_number": {
      "type": "number",
      "description": "N\u00famero consecutivo asignado en la serie nueva"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "migrado",
        "error"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pendiente",
      "description": "Estado de la migraci\u00f3n de este cliente"
    },
    "related_updates": {
      "type": "object",
      "description": "Cantidad de registros actualizados por tipo (paquetes, recibos, bultos, etc.)"
    },
    "error": {
      "type": "string",
      "description": "Detalle del error si la migraci\u00f3n de este cliente fall\u00f3"
    },
    "migrated_date": {
      "type": "string",
      "format": "date-time"
    },
    "migrated_by": {
      "type": "string",
      "description": "Email del administrador que ejecut\u00f3 la migraci\u00f3n"
    }
  },
  "required": [
    "user_id",
    "old_mark"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}