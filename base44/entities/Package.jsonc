{
  "name": "Package",
  "type": "object",
  "properties": {
    "tracking_number": {
      "type": "string",
      "description": "Unique tracking number"
    },
    "client_email": {
      "type": "string",
      "description": "Client email who owns this package. Vac\u00edo para paquetes hu\u00e9rfanos (sin cliente asignado)."
    },
    "shipping_mark": {
      "type": "string",
      "description": "Client's shipping mark"
    },
    "label_code": {
      "type": "string",
      "description": "C\u00f3digo de etiqueta TLEC (shipping_mark-L##) vinculado a este paquete. Permite encontrar el paquete escaneando el c\u00f3digo de barras de la etiqueta."
    },
    "shipping_type": {
      "type": "string",
      "enum": [
        "aereo",
        "maritimo"
      ],
      "description": "Type of shipping"
    },
    "risk_category": {
      "type": "string",
      "enum": [
        "general",
        "alto_riesgo"
      ],
      "default": "general",
      "description": "Tipo de carga: general o alto riesgo"
    },
    "package_count": {
      "type": "number",
      "description": "Cantidad de bultos o paquetes declarados por el cliente",
      "default": 1
    },
    "description": {
      "type": "string",
      "description": "Package description"
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_alerta",
        "recibido",
        "rechazado",
        "consolidado",
        "en_transito",
        "disponible",
        "despachado",
        "entregado",
        "sin_cliente"
      ],
      "default": "pre_alerta"
    },
    "is_orphan": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el paquete es un hu\u00e9rfano (lleg\u00f3 sin pre-alerta y no tiene cliente asignado). Cuando se asigna o reclama, pasa a false."
    },
    "ai_unreadable": {
      "type": "boolean",
      "default": false,
      "description": "Indica que la IA no pudo leer el tracking de la foto. Se excluye de futuros escaneos IA autom\u00e1ticos. El admin puede reintentar manualmente."
    },
    "ai_attempted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo intento de IA donde se ley\u00f3 el tracking pero no se encontr\u00f3 cliente coincidente. Se usa para excluir el paquete de lotes recientes y evitar reprocesamiento en bucle."
    },
    "has_insurance": {
      "type": "boolean",
      "default": false
    },
    "fob_value": {
      "type": "number",
      "description": "FOB value for insurance"
    },
    "insurance_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha l\u00edmite para pagar el seguro tras un rechazo del admin (ahora + 12h). Si vence sin pago aprobado, el paquete queda sin seguro permanente."
    },
    "insurance_expired": {
      "type": "boolean",
      "default": false,
      "description": "Indica si venci\u00f3 el plazo de 12h para pagar el seguro tras rechazo. El paquete queda sin seguro permanente."
    },
    "invoice_url": {
      "type": "string",
      "description": "Invoice file URL"
    },
    "product_image_url": {
      "type": "string",
      "description": "Foto del producto subida por el cliente en la pre-alerta"
    },
    "package_image_url": {
      "type": "string",
      "description": "Legacy single image URL (kept for backwards compatibility)"
    },
    "package_image_urls": {
      "type": "array",
      "description": "Up to 3 image URLs for the received package",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "default": []
    },
    "consolidation_id": {
      "type": "string",
      "description": "ID of consolidation if consolidated"
    },
    "received_date": {
      "type": "string",
      "format": "date-time"
    },
    "received_by": {
      "type": "string"
    },
    "ve_recognized_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que la carga fue reconocida en el almac\u00e9n de Venezuela al escanear el bulto que la contiene (/BultoOrderScan). Marca que el paquete ya est\u00e1 en Venezuela y lo excluye del resumen diario de recepci\u00f3n del almac\u00e9n de China."
    },
    "ve_recognized_by": {
      "type": "string",
      "description": "Usuario o dispositivo que reconoci\u00f3 la carga en el almac\u00e9n de Venezuela"
    },
    "ve_notified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se avis\u00f3 al cliente que su carga ya est\u00e1 en Venezuela (resumen diario). Evita repetir el email."
    },
    "dispatched_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en la que el paquete fue despachado en almac\u00e9n"
    },
    "dispatched_by": {
      "type": "string",
      "description": "Usuario que marc\u00f3 el paquete como despachado"
    },
    "reported": {
      "type": "boolean",
      "default": false,
      "description": "Marcado como reportado para control interno"
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID del almac\u00e9n o sede donde est\u00e1 el paquete"
    },
    "warehouse_name": {
      "type": "string",
      "description": "Nombre del almac\u00e9n o sede"
    },
    "warehouse_city": {
      "type": "string",
      "description": "Ciudad del almac\u00e9n"
    },
    "warehouse_country": {
      "type": "string",
      "description": "Pa\u00eds del almac\u00e9n"
    },
    "warehouse_location_id": {
      "type": "string",
      "description": "ID de la ubicaci\u00f3n de almac\u00e9n asignada"
    },
    "warehouse_location_code": {
      "type": "string",
      "description": "C\u00f3digo de la ubicaci\u00f3n de almac\u00e9n"
    },
    "warehouse_location_name": {
      "type": "string",
      "description": "Nombre de la ubicaci\u00f3n de almac\u00e9n"
    },
    "warehouse_zone": {
      "type": "string",
      "description": "Zona operativa donde est\u00e1 ubicado el paquete"
    },
    "actual_weight_kg": {
      "type": "number",
      "description": "Peso real del paquete al recibirlo"
    },
    "actual_length_cm": {
      "type": "number",
      "description": "Largo real del paquete en cm"
    },
    "actual_width_cm": {
      "type": "number",
      "description": "Ancho real del paquete en cm"
    },
    "actual_height_cm": {
      "type": "number",
      "description": "Alto real del paquete en cm"
    },
    "actual_cbm": {
      "type": "number",
      "description": "Volumen real del paquete en CBM"
    },
    "reception_notes": {
      "type": "string",
      "description": "Notas internas al momento de recibir o ubicar el paquete"
    },
    "shipping_company": {
      "type": "string",
      "description": "Compa\u00f1\u00eda de transporte del tracking"
    },
    "shipping_address": {
      "type": "string",
      "description": "Direcci\u00f3n de entrega asociada al tracking"
    },
    "delivery_proof_request_sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en la que se envi\u00f3 la solicitud autom\u00e1tica del comprobante de entrega"
    },
    "seller_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha en la que el vendedor entreg\u00f3 el paquete al almac\u00e9n (informada por el cliente)"
    }
  },
  "required": [
    "tracking_number",
    "shipping_type",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}