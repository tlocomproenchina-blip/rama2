{
  "name": "StorageChargeConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "default": "main",
      "description": "Clave \u00fanica de configuraci\u00f3n"
    },
    "charges_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Interruptor general: cuando est\u00e1 activo, el proceso diario agrega cargos de almacenamiento y custodia a las facturas impagas desde el d\u00eda siguiente a los d\u00edas gratuitos. Apagado = cargos en pausa."
    },
    "charges_enabled_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo cambio del interruptor"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Activa o desactiva el c\u00e1lculo autom\u00e1tico de cargos de almacenamiento"
    },
    "free_days": {
      "type": "number",
      "default": 7,
      "description": "D\u00edas de almacenamiento gratuito (el d\u00eda 1 es el siguiente a la emisi\u00f3n; el cargo fijo llega el d\u00eda siguiente)"
    },
    "max_days": {
      "type": "number",
      "default": 45,
      "description": "\u00daltimo d\u00eda del contrato en que se acumulan cargos de almacenamiento"
    },
    "fixed_fee": {
      "type": "number",
      "default": 100,
      "description": "Cargo fijo \u00fanico (USD) por factura al llegar el d\u00eda 8"
    },
    "daily_rate": {
      "type": "number",
      "default": 20,
      "description": "Cargo diario (USD) por factura desde el d\u00eda 9"
    },
    "standard_daily_rate": {
      "type": "number",
      "default": 10,
      "description": "DEPRECATED: tarifa diaria por bulto est\u00e1ndar del m\u00e9todo anterior por tama\u00f1o (descontinuado)"
    },
    "large_daily_rate": {
      "type": "number",
      "default": 20,
      "description": "DEPRECATED: tarifa diaria por bulto grande del m\u00e9todo anterior por tama\u00f1o (descontinuado)"
    },
    "forklift_fee": {
      "type": "number",
      "default": 150,
      "description": "Recargo (USD) por uso de montacargas, aplicado aparte en la factura"
    },
    "standard_max_cbm": {
      "type": "number",
      "default": 0.027,
      "description": "DEPRECATED: volumen m\u00e1ximo para bulto est\u00e1ndar del m\u00e9todo anterior por tama\u00f1o"
    },
    "standard_max_cm": {
      "type": "number",
      "default": 30,
      "description": "DEPRECATED: lado m\u00e1ximo en cent\u00edmetros del m\u00e9todo anterior"
    },
    "large_if_multiple_packages": {
      "type": "boolean",
      "default": true,
      "description": "DEPRECATED: regla de bulto grande del m\u00e9todo anterior por tama\u00f1o"
    },
    "default_category": {
      "type": "string",
      "enum": [
        "estandar",
        "grande"
      ],
      "default": "estandar",
      "description": "DEPRECATED: categor\u00eda por defecto del m\u00e9todo anterior por tama\u00f1o"
    },
    "fallback_unit_per_order": {
      "type": "boolean",
      "default": true,
      "description": "Cuando la factura no tiene bultos registrados, tomar sus env\u00edos como referencia de unidades en almac\u00e9n"
    },
    "notify_client": {
      "type": "boolean",
      "default": true,
      "description": "Avisar al cliente por notificaci\u00f3n in-app y email cada vez que se agregan cargos"
    },
    "skip_threshold_days": {
      "type": "boolean",
      "default": true,
      "description": "No enviar el aviso diario los d\u00edas 20, 30 y 45 porque ya los cubren las plantillas de almacenamiento existentes"
    },
    "updated_by": {
      "type": "string",
      "description": "Email del administrador que guard\u00f3 la configuraci\u00f3n"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}