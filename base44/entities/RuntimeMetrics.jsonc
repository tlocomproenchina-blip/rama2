{
  "name": "RuntimeMetrics",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email del cliente/empleado que reporta"
    },
    "role": {
      "type": "string",
      "description": "Rol del usuario (admin, user, etc.)"
    },
    "page_name": {
      "type": "string",
      "description": "P\u00e1gina (ruta) en la que se hicieron las llamadas medidas"
    },
    "queue_length": {
      "type": "number",
      "description": "Longitud de la cola local"
    },
    "active_reads": {
      "type": "number",
      "description": "Lecturas activas locales"
    },
    "active_writes": {
      "type": "number",
      "description": "Escrituras activas locales"
    },
    "max_reads": {
      "type": "number",
      "description": "L\u00edmite de lecturas configurado"
    },
    "max_writes": {
      "type": "number",
      "description": "L\u00edmite de escrituras configurado"
    },
    "failure_count": {
      "type": "number",
      "description": "Errores recientes (rate limit)"
    },
    "circuit_state": {
      "type": "string",
      "enum": [
        "CLOSED",
        "OPEN",
        "HALF_OPEN"
      ],
      "description": "Estado del circuit breaker"
    },
    "cache_size": {
      "type": "number",
      "description": "Tama\u00f1o del cache local"
    },
    "inflight_size": {
      "type": "number",
      "description": "Operaciones en vuelo deduplicadas"
    },
    "latency_ms_avg": {
      "type": "number",
      "description": "Latencia promedio medida (ms)",
      "default": 0
    },
    "latency_ms_p95": {
      "type": "number",
      "description": "Latencia del 5% m\u00e1s lento de las llamadas (ms)",
      "default": 0
    },
    "latency_ms_max": {
      "type": "number",
      "description": "Latencia m\u00e1xima medida (ms)",
      "default": 0
    },
    "window_seconds": {
      "type": "number",
      "description": "Duraci\u00f3n de la ventana medida en segundos"
    },
    "total_calls": {
      "type": "number",
      "default": 0,
      "description": "Llamadas al servidor hechas en la ventana"
    },
    "read_calls": {
      "type": "number",
      "default": 0,
      "description": "Lecturas en la ventana"
    },
    "write_calls": {
      "type": "number",
      "default": 0,
      "description": "Escrituras en la ventana"
    },
    "function_calls": {
      "type": "number",
      "default": 0,
      "description": "Llamadas a funciones de servidor en la ventana"
    },
    "rate_limit_hits": {
      "type": "number",
      "default": 0,
      "description": "Respuestas 429 (exceso de solicitudes) recibidas"
    },
    "retries": {
      "type": "number",
      "default": 0,
      "description": "Reintentos autom\u00e1ticos hechos"
    },
    "timeouts": {
      "type": "number",
      "default": 0,
      "description": "Llamadas que superaron el tiempo m\u00e1ximo de espera"
    },
    "error_count": {
      "type": "number",
      "default": 0,
      "description": "Llamadas que terminaron en error"
    },
    "peak_queue": {
      "type": "number",
      "default": 0,
      "description": "Mayor cantidad de llamadas en espera durante la ventana"
    },
    "peak_concurrency": {
      "type": "number",
      "default": 0,
      "description": "Mayor cantidad de llamadas simult\u00e1neas durante la ventana"
    },
    "top_operations": {
      "type": "array",
      "default": [],
      "description": "Operaciones m\u00e1s frecuentes de la ventana con su latencia promedio y errores",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "avg_ms": {
            "type": "number"
          },
          "errors": {
            "type": "number"
          }
        }
      }
    },
    "device_cores": {
      "type": "number",
      "description": "N\u00facleos reportados por el navegador"
    },
    "is_mobile": {
      "type": "boolean",
      "description": "Si el cliente es m\u00f3vil",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "queue_length",
    "active_reads",
    "active_writes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}