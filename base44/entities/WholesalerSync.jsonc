{
  "name": "WholesalerSync",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "default": "main",
      "description": "Clave \u00fanica de la conexi\u00f3n con ese cliente mayorista ('main' o ws-...)"
    },
    "wholesaler_name": {
      "type": "string",
      "default": "Cliente mayorista"
    },
    "invoice_email": {
      "type": "string",
      "description": "Correo del mayorista al que se le env\u00edan las facturas de sus clientes"
    },
    "rate_per_cbm": {
      "type": "number",
      "description": "Tarifa del servicio de env\u00edo (USD por CBM)"
    },
    "door_to_door_per_cbm": {
      "type": "number",
      "description": "Tarifa de puerta a puerta (USD por CBM)"
    },
    "rate_per_bulto": {
      "type": "number",
      "description": "DEPRECATED: tarifa de puerta a puerta por bulto, reemplazada por door_to_door_per_cbm"
    },
    "clients_feed_url": {
      "type": "string"
    },
    "history_feed_url": {
      "type": "string"
    },
    "history_sync_enabled": {
      "type": "boolean",
      "default": true
    },
    "notify_url": {
      "type": "string"
    },
    "inbound_key": {
      "type": "string"
    },
    "outbound_key": {
      "type": "string"
    },
    "intake_enabled": {
      "type": "boolean",
      "default": true
    },
    "report_email_enabled": {
      "type": "boolean",
      "default": true
    },
    "notify_enabled": {
      "type": "boolean",
      "default": true
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "conectado",
        "error",
        "sin_probar"
      ],
      "default": "sin_probar"
    },
    "connection_checked_date": {
      "type": "string",
      "format": "date-time"
    },
    "connection_message": {
      "type": "string",
      "maxLength": 1000
    },
    "connection_clients_count": {
      "type": "number",
      "default": 0
    },
    "consecutive_failures": {
      "type": "number",
      "default": 0
    },
    "alerted_message": {
      "type": "string",
      "maxLength": 1000
    },
    "alerted_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_cursor": {
      "type": "string",
      "format": "date-time"
    },
    "last_run_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_run_status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "nunca"
      ],
      "default": "nunca"
    },
    "last_run_message": {
      "type": "string",
      "maxLength": 1000
    },
    "last_run_clients_count": {
      "type": "number",
      "default": 0
    },
    "last_history_run_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_history_status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "nunca"
      ],
      "default": "nunca"
    },
    "last_history_message": {
      "type": "string",
      "maxLength": 1000
    },
    "last_history_total": {
      "type": "number",
      "default": 0
    },
    "last_history_new": {
      "type": "number",
      "default": 0
    },
    "last_history_updated": {
      "type": "number",
      "default": 0
    },
    "last_history_skipped": {
      "type": "number",
      "default": 0
    },
    "last_history_errors": {
      "type": "number",
      "default": 0
    },
    "last_history_pages": {
      "type": "number",
      "default": 0
    },
    "last_history_assigned": {
      "type": "number",
      "default": 0
    },
    "last_history_notified": {
      "type": "number",
      "default": 0
    },
    "last_history_notify_failed": {
      "type": "number",
      "default": 0
    },
    "last_history_notify_pending": {
      "type": "number",
      "default": 0
    },
    "last_history_detail": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "tracking": {
            "type": "string"
          },
          "client_email": {
            "type": "string"
          },
          "shipping_mark": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "resultado": {
            "type": "string",
            "enum": [
              "nuevo",
              "completado",
              "alineado",
              "con_error"
            ]
          },
          "estado": {
            "type": "string"
          },
          "asignado": {
            "type": "boolean",
            "default": false
          },
          "aviso": {
            "type": "string",
            "enum": [
              "enviado",
              "fallido",
              "omitido",
              "pendiente",
              "sin_foto",
              "no_recibido",
              "no_aplica"
            ]
          },
          "fotos": {
            "type": "number"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "mensaje": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "last_report_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_report_status": {
      "type": "string",
      "enum": [
        "enviado",
        "sin_clientes",
        "fallido",
        "nunca"
      ],
      "default": "nunca"
    },
    "last_report_clients_count": {
      "type": "number",
      "default": 0
    },
    "last_report_message": {
      "type": "string",
      "maxLength": 1000
    },
    "last_reception_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_reception_tracking": {
      "type": "string"
    },
    "last_reception_status": {
      "type": "string"
    },
    "last_notify_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_notify_status": {
      "type": "string"
    },
    "last_notify_message": {
      "type": "string",
      "maxLength": 1000
    },
    "pending_notifications": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}