{
  "name": "WholesalerSync",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "default": "main",
      "description": "Clave \u00fanica de la conexi\u00f3n con ese cliente mayorista. La conexi\u00f3n de siempre conserva 'main'; las conexiones nuevas usan una clave propia (ws-...)."
    },
    "wholesaler_name": {
      "type": "string",
      "default": "Cliente mayorista",
      "description": "Nombre del cliente mayorista, usado en el panel, en los avisos y en el informe"
    },
    "clients_feed_url": {
      "type": "string",
      "description": "Direcci\u00f3n de la app del mayorista a la que esta app le pide sus clientes nuevos cada 24 horas"
    },
    "history_feed_url": {
      "type": "string",
      "description": "Direcci\u00f3n de la app del mayorista a la que esta app le pide su historial completo de pre-alertas (paginado). Se consulta todos los d\u00edas a las 3:00 a.m. (Caracas) y cuando un administrador lo pide desde el panel."
    },
    "history_sync_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activa la consulta diaria del historial completo de pre-alertas de ese mayorista"
    },
    "notify_url": {
      "type": "string",
      "description": "Direcci\u00f3n de la app del mayorista a la que esta app avisa cuando su carga se recibi\u00f3 en el almac\u00e9n de China"
    },
    "inbound_key": {
      "type": "string",
      "description": "Clave con la que ese mayorista llama a esta app (consultar tracking, recepcionar, reportar pre-alerta, pedir clientes). Si est\u00e1 vac\u00eda se usa la clave de Secretos, para no romper la conexi\u00f3n que ya estaba emparejada."
    },
    "outbound_key": {
      "type": "string",
      "description": "Clave con la que esta app llama a ese mayorista (pedirle sus clientes, pedirle su historial de pre-alertas y avisarle las recepciones). Si est\u00e1 vac\u00eda se usa la clave de Secretos."
    },
    "intake_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activa la consulta diaria de clientes nuevos en la app de ese mayorista"
    },
    "report_email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activa el env\u00edo del informe diario por correo a los administradores"
    },
    "notify_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activa el aviso inmediato a ese mayorista cuando su carga se recibe en China"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "conectado",
        "error",
        "sin_probar"
      ],
      "default": "sin_probar",
      "description": "Estado de la conexi\u00f3n: conectado (respondi\u00f3), error (no respondi\u00f3) o sin_probar (todav\u00eda no se ha probado)"
    },
    "connection_checked_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima verificaci\u00f3n de la conexi\u00f3n (prueba desde el panel o corte diario)"
    },
    "connection_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle del \u00faltimo estado de la conexi\u00f3n"
    },
    "connection_clients_count": {
      "type": "number",
      "default": 0,
      "description": "Clientes que respondi\u00f3 la app del mayorista en la \u00faltima verificaci\u00f3n"
    },
    "consecutive_failures": {
      "type": "number",
      "default": 0,
      "description": "Intentos seguidos sin respuesta. Vuelve a cero cuando la conexi\u00f3n responde."
    },
    "alerted_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Motivo del \u00faltimo aviso enviado a los administradores: evita repetir el mismo aviso en cada intento"
    },
    "alerted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo aviso enviado a los administradores por esta conexi\u00f3n"
    },
    "last_cursor": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo corte entregado al mayorista: en la pr\u00f3xima consulta se le piden los clientes desde ese momento, para no repetir ni perder ninguno"
    },
    "last_run_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima consulta de clientes nuevos"
    },
    "last_run_status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "nunca"
      ],
      "default": "nunca",
      "description": "Resultado de la \u00faltima consulta de clientes nuevos"
    },
    "last_run_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle del resultado de la \u00faltima consulta"
    },
    "last_run_clients_count": {
      "type": "number",
      "default": 0,
      "description": "Clientes tra\u00eddos en la \u00faltima consulta"
    },
    "last_history_run_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima sincronizaci\u00f3n del historial de pre-alertas de ese mayorista"
    },
    "last_history_status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "nunca"
      ],
      "default": "nunca",
      "description": "Resultado de la \u00faltima sincronizaci\u00f3n del historial: ok (se consult\u00f3), error (no respondi\u00f3) o nunca (todav\u00eda no se ha intentado)"
    },
    "last_history_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle de la \u00faltima sincronizaci\u00f3n del historial: cu\u00e1ntas pre-alertas se registraron, se completaron o ya estaban alineadas, y cu\u00e1ntas coincidencias se le devolvieron al mayorista"
    },
    "last_history_total": {
      "type": "number",
      "default": 0,
      "description": "Pre-alertas que trajo el historial en la \u00faltima sincronizaci\u00f3n"
    },
    "last_history_new": {
      "type": "number",
      "default": 0,
      "description": "Pre-alertas nuevas registradas en la \u00faltima sincronizaci\u00f3n del historial"
    },
    "last_history_updated": {
      "type": "number",
      "default": 0,
      "description": "Pre-alertas que ya exist\u00edan y se completaron con datos que faltaban en la \u00faltima sincronizaci\u00f3n del historial"
    },
    "last_history_skipped": {
      "type": "number",
      "default": 0,
      "description": "Pre-alertas que ya estaban alineadas: no se tocaron en la \u00faltima sincronizaci\u00f3n del historial"
    },
    "last_history_errors": {
      "type": "number",
      "default": 0,
      "description": "Pre-alertas que no se pudieron procesar en la \u00faltima sincronizaci\u00f3n del historial"
    },
    "last_history_pages": {
      "type": "number",
      "default": 0,
      "description": "P\u00e1ginas del historial que se consultaron en la \u00faltima sincronizaci\u00f3n"
    },
    "last_history_notified": {
      "type": "number",
      "default": 0,
      "description": "Coincidencias ya recibidas en el almac\u00e9n que se le devolvieron al mayorista en la \u00faltima sincronizaci\u00f3n del historial, para que su app marque esas cargas como recibidas"
    },
    "last_history_notify_failed": {
      "type": "number",
      "default": 0,
      "description": "Avisos de esas coincidencias que no se pudieron entregar al mayorista en la \u00faltima sincronizaci\u00f3n del historial"
    },
    "last_report_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo informe de clientes nuevos"
    },
    "last_report_status": {
      "type": "string",
      "enum": [
        "enviado",
        "sin_clientes",
        "fallido",
        "nunca"
      ],
      "default": "nunca",
      "description": "Resultado del \u00faltimo informe: enviado, sin_clientes (no se env\u00eda correo), fallido"
    },
    "last_report_clients_count": {
      "type": "number",
      "default": 0,
      "description": "Clientes incluidos en el \u00faltimo informe"
    },
    "last_report_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle del resultado del \u00faltimo informe"
    },
    "last_reception_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima carga de ese mayorista marcada como recibida en el almac\u00e9n de China"
    },
    "last_reception_tracking": {
      "type": "string",
      "description": "Tracking de la \u00faltima carga recibida"
    },
    "last_reception_status": {
      "type": "string",
      "description": "Resultado de la \u00faltima recepci\u00f3n pedida por el mayorista"
    },
    "last_notify_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del \u00faltimo aviso enviado a la app del mayorista"
    },
    "last_notify_status": {
      "type": "string",
      "description": "Resultado del \u00faltimo aviso enviado al mayorista"
    },
    "last_notify_message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle del \u00faltimo aviso enviado al mayorista"
    },
    "pending_notifications": {
      "type": "number",
      "default": 0,
      "description": "Recepciones de ese mayorista que todav\u00eda no se han podido avisar a su app"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}