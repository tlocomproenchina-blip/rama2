{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico de factura"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "consolidation_id": {
      "type": "string",
      "description": "ID de la consolidaci\u00f3n"
    },
    "consolidation_tracking": {
      "type": "string",
      "description": "Tracking de la consolidaci\u00f3n"
    },
    "invoice_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de emisi\u00f3n"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "description": "Items de la factura"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal antes de impuestos"
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "Impuestos"
    },
    "total": {
      "type": "number",
      "description": "Total a pagar"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "Suma de abonos aprobados (cache para mostrar saldo)"
    },
    "total_cbm": {
      "type": "number",
      "description": "CBM total sumado de los recibos incluidos en la factura"
    },
    "billed_cbm": {
      "type": "number",
      "description": "CBM facturado ingresado manualmente (por defecto igual al CBM total)"
    },
    "manual_recibos": {
      "type": "array",
      "default": [],
      "description": "Detalle de recibos (CbmIngreso) incluidos en una factura manual. Permite vincular \u00f3rdenes de despacho al pago.",
      "items": {
        "type": "object",
        "properties": {
          "cbm_ingreso_id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "cbm": {
            "type": "number"
          },
          "tracking_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "cost_breakdown": {
      "type": "object",
      "description": "Desglose de costos para facturas manuales. Permite calcular el monto independiente de cada orden de despacho.",
      "properties": {
        "total_cbm": {
          "type": "number"
        },
        "shipping_total": {
          "type": "number"
        },
        "insurance_total": {
          "type": "number"
        },
        "consolidation_fee": {
          "type": "number"
        },
        "door_to_door_fee": {
          "type": "number"
        },
        "extra_amount": {
          "type": "number"
        },
        "extra_concept": {
          "type": "string"
        },
        "rate_per_cbm": {
          "type": "number"
        }
      }
    },
    "provider_cost_total": {
      "type": "number",
      "description": "Costo total al proveedor asociado a esta factura"
    },
    "profit_amount": {
      "type": "number",
      "description": "Ganancia neta de la factura (total facturado - costo proveedor)"
    },
    "provider_paid": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el costo al proveedor de esta factura ya fue pagado"
    },
    "provider_paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se marc\u00f3 como pagado al proveedor"
    },
    "provider_invoice_image_url": {
      "type": "string",
      "description": "URL de la imagen de la factura del proveedor (ImgBB, uso interno)"
    },
    "provider_payment_history": {
      "type": "array",
      "default": [],
      "description": "Historial de abonos pagados al proveedor (cada monto se acumula en provider_cost_total)",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Descripci\u00f3n o nota del abono"
          },
          "amount": {
            "type": "number",
            "description": "Monto del abono"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha del abono"
          }
        }
      }
    },
    "dispatched": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la carga de esta factura ya fue despachada"
    },
    "dispatched_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se marc\u00f3 como despachada"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "revision",
        "pagada",
        "vencida",
        "cancelada"
      ],
      "default": "pendiente",
      "description": "Estado de la factura"
    },
    "payment_method": {
      "type": "string",
      "description": "M\u00e9todo de pago utilizado"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de pago"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia del pago"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "ID del payment intent de Stripe"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "ID de la factura de Stripe"
    },
    "stripe_hosted_invoice_url": {
      "type": "string",
      "description": "URL hospedada de la factura de Stripe"
    },
    "stripe_invoice_pdf_url": {
      "type": "string",
      "description": "URL directa del PDF de la factura de Stripe"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "payment_history": {
      "type": "array",
      "default": [],
      "description": "Historial de pagos Stripe asociados a la factura",
      "items": {
        "type": "object",
        "properties": {
          "method_brand": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          },
          "amount_paid": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "payment_intent_id": {
            "type": "string"
          },
          "charge_id": {
            "type": "string"
          }
        }
      }
    },
    "storage_notif_20_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de almacenamiento de los 20 d\u00edas"
    },
    "storage_notif_30_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de almacenamiento de los 30 d\u00edas vencidos"
    },
    "storage_notif_45_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de remate de los 45 d\u00edas"
    },
    "origin_app_id": {
      "type": "string",
      "description": "ID de la app integrada (IntegratedApp) que emiti\u00f3 esta factura desde una copia. Vac\u00edo = emitida directamente en TLEC CARGO."
    },
    "origin_app_label": {
      "type": "string",
      "description": "Nombre de la app integrada que origin\u00f3 el registro (cache para mostrar)"
    }
  },
  "required": [
    "client_email",
    "consolidation_id",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}