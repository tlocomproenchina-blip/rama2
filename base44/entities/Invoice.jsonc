{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico de factura"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "consolidation_id": {
      "type": "string",
      "description": "ID de la consolidaci\u00f3n"
    },
    "consolidation_tracking": {
      "type": "string",
      "description": "Tracking de la consolidaci\u00f3n"
    },
    "invoice_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de emisi\u00f3n"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "description": "Items de la factura"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal antes de impuestos"
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "Impuestos"
    },
    "total": {
      "type": "number",
      "description": "Total a pagar"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "Suma de abonos aprobados (cache para mostrar saldo)"
    },
    "total_cbm": {
      "type": "number",
      "description": "CBM total sumado de los recibos incluidos en la factura"
    },
    "billed_cbm": {
      "type": "number",
      "description": "CBM facturado ingresado manualmente (por defecto igual al CBM total)"
    },
    "manual_recibos": {
      "type": "array",
      "default": [],
      "description": "Detalle de recibos (CbmIngreso) incluidos en una factura manual. Permite vincular \u00f3rdenes de despacho al pago.",
      "items": {
        "type": "object",
        "properties": {
          "cbm_ingreso_id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "cbm": {
            "type": "number"
          },
          "tracking_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "cost_breakdown": {
      "type": "object",
      "description": "Desglose de costos para facturas manuales. Permite calcular el monto independiente de cada orden de despacho.",
      "properties": {
        "total_cbm": {
          "type": "number"
        },
        "shipping_total": {
          "type": "number"
        },
        "insurance_total": {
          "type": "number"
        },
        "consolidation_fee": {
          "type": "number"
        },
        "door_to_door_fee": {
          "type": "number"
        },
        "extra_amount": {
          "type": "number"
        },
        "extra_concept": {
          "type": "string"
        },
        "rate_per_cbm": {
          "type": "number"
        }
      }
    },
    "provider_cost_total": {
      "type": "number",
      "description": "Costo total al proveedor asociado a esta factura"
    },
    "profit_amount": {
      "type": "number",
      "description": "Ganancia neta de la factura (total facturado - costo proveedor)"
    },
    "provider_paid": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el costo al proveedor de esta factura ya fue pagado"
    },
    "provider_paid_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se marc\u00f3 como pagado al proveedor"
    },
    "provider_invoice_image_url": {
      "type": "string",
      "description": "URL de la imagen de la factura del proveedor (ImgBB, uso interno)"
    },
    "provider_payment_history": {
      "type": "array",
      "default": [],
      "description": "Historial de abonos pagados al proveedor (cada monto se acumula en provider_cost_total)",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Descripci\u00f3n o nota del abono"
          },
          "amount": {
            "type": "number",
            "description": "Monto del abono"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha del abono"
          }
        }
      }
    },
    "warehouse_order": {
      "type": "object",
      "description": "Orden de almac\u00e9n armada al marcar la factura como pagada a mano: snapshot de los bultos que esta factura liber\u00f3 (Bulto.billed_invoice_id), agrupados por shipping mark y N\u00b0 de orden/env\u00edo, con la etiqueta de cada bulto, cu\u00e1ntos bultos tiene cada orden y el total. Se guarda para que no cambie si luego se editan los bultos; se recalcula solo cuando un admin la regenera a prop\u00f3sito.",
      "properties": {
        "generated_date": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha en que se arm\u00f3 la orden de almac\u00e9n"
        },
        "generated_by": {
          "type": "string",
          "description": "Email del admin que marc\u00f3 la factura como pagada y gener\u00f3 la orden"
        },
        "regenerated_date": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de la \u00faltima regeneraci\u00f3n manual de la orden"
        },
        "regenerated_by": {
          "type": "string",
          "description": "Email del admin que regener\u00f3 la orden"
        },
        "client_name": {
          "type": "string",
          "description": "Nombre del cliente al momento de armar la orden"
        },
        "shipping_mark": {
          "type": "string",
          "description": "Shipping mark del cliente al momento de armar la orden"
        },
        "groups": {
          "type": "array",
          "default": [],
          "description": "Bultos agrupados por shipping mark y N\u00b0 de orden/env\u00edo. Un bulto con varios N\u00b0 de orden aparece en cada uno de ellos; los bultos sin N\u00b0 de orden van al grupo 'Sin N\u00b0 de orden'.",
          "items": {
            "type": "object",
            "properties": {
              "shipping_mark": {
                "type": "string"
              },
              "order_number": {
                "type": "string",
                "description": "N\u00b0 de orden/env\u00edo (CbmIngreso) o 'Sin N\u00b0 de orden'"
              },
              "bultos_count": {
                "type": "number",
                "description": "Cu\u00e1ntos bultos tiene este N\u00b0 de orden"
              },
              "packages_count": {
                "type": "number",
                "description": "Paquetes reales sumados de los bultos de este N\u00b0 de orden"
              },
              "bultos": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "object",
                  "properties": {
                    "label_code": {
                      "type": "string",
                      "description": "Etiqueta del bulto o de la caja consolidada"
                    },
                    "bulto_number": {
                      "type": "number"
                    },
                    "is_caja": {
                      "type": "boolean",
                      "default": false
                    },
                    "caja_number": {
                      "type": "number"
                    },
                    "caja_total": {
                      "type": "number"
                    },
                    "package_count": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "description": "Totales de la orden: el total de bultos no repite bultos que aparecen en m\u00e1s de un N\u00b0 de orden.",
          "properties": {
            "groups": {
              "type": "number"
            },
            "bultos": {
              "type": "number"
            },
            "packages": {
              "type": "number"
            }
          }
        }
      }
    },
    "dispatched": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la carga de esta factura ya fue despachada"
    },
    "dispatched_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se marc\u00f3 como despachada"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "revision",
        "pagada",
        "vencida",
        "cancelada"
      ],
      "default": "pendiente",
      "description": "Estado de la factura"
    },
    "payment_method": {
      "type": "string",
      "description": "M\u00e9todo de pago utilizado"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de pago"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia del pago"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "ID del payment intent de Stripe"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "ID de la factura de Stripe"
    },
    "stripe_hosted_invoice_url": {
      "type": "string",
      "description": "URL hospedada de la factura de Stripe"
    },
    "stripe_invoice_pdf_url": {
      "type": "string",
      "description": "URL directa del PDF de la factura de Stripe"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "payment_history": {
      "type": "array",
      "default": [],
      "description": "Historial de pagos Stripe asociados a la factura",
      "items": {
        "type": "object",
        "properties": {
          "method_brand": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          },
          "amount_paid": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "payment_intent_id": {
            "type": "string"
          },
          "charge_id": {
            "type": "string"
          }
        }
      }
    },
    "storage_notif_20_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de almacenamiento de los 20 d\u00edas"
    },
    "storage_notif_30_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de almacenamiento de los 30 d\u00edas vencidos"
    },
    "storage_notif_45_sent": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se envi\u00f3 la notificaci\u00f3n de remate de los 45 d\u00edas"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Factura protegida: no se puede editar su contenido ni sus montos. Los procesos autom\u00e1ticos (rec\u00e1lculo de tarifas, cargos de almacenamiento, montacargas, fusi\u00f3n de recibos duplicados) la omiten y la pantalla de facturas esconde sus controles de edici\u00f3n."
    },
    "lock_reason": {
      "type": "string",
      "description": "Motivo por el que la factura qued\u00f3 protegida"
    },
    "locked_by": {
      "type": "string",
      "description": "Email del administrador que protegi\u00f3 la factura"
    },
    "locked_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que la factura qued\u00f3 protegida"
    },
    "amount_restore": {
      "type": "object",
      "description": "Registro de la restauraci\u00f3n de montos: qui\u00e9n la hizo, cu\u00e1ndo y los importes anteriores y restaurados.",
      "properties": {
        "restored_date": {
          "type": "string",
          "format": "date-time"
        },
        "restored_by": {
          "type": "string"
        },
        "before_total": {
          "type": "number"
        },
        "restored_total": {
          "type": "number"
        },
        "before_shipping": {
          "type": "number"
        },
        "restored_shipping": {
          "type": "number"
        },
        "source_note": {
          "type": "string",
          "description": "Registro del rec\u00e1lculo que se est\u00e1 corrigiendo"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "client_email",
    "consolidation_id",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}