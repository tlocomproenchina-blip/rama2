{
  "name": "FiscalDocument",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "request_number": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "definitivo"
      ],
      "default": "definitivo",
      "description": "Copia del documento fiscal definitivo emitido"
    },
    "document_number": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "file_uri": {
      "type": "string",
      "description": "Archivo privado"
    },
    "file_type": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}