{
  "name": "SupportQuickMessage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo corto del mensaje"
    },
    "category": {
      "type": "string",
      "enum": [
        "saludo",
        "seguimiento",
        "pago",
        "tracking",
        "cierre",
        "otro"
      ],
      "default": "otro",
      "description": "Categor\u00eda del mensaje"
    },
    "message": {
      "type": "string",
      "description": "Contenido del mensaje predeterminado"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Im\u00e1genes opcionales del mensaje"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si est\u00e1 disponible para usar"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}