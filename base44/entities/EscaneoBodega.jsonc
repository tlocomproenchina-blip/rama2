{
  "name": "EscaneoBodega",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "ID del dispositivo que realiz\u00f3 el escaneo"
    },
    "tracking_number": {
      "type": "string",
      "description": "N\u00famero de tracking escaneado (o 'foto manual' si no tiene)"
    },
    "shipping_mark": {
      "type": "string",
      "description": "Shipping mark del cliente si el paquete estaba pre-alertado"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto del paquete (Bunny CDN)"
    },
    "result_type": {
      "type": "string",
      "enum": [
        "recibido",
        "huerfano",
        "duplicado"
      ],
      "description": "Tipo de resultado del escaneo"
    }
  },
  "required": [
    "device_id",
    "result_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}