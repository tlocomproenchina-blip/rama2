{
  "name": "IntegratedApp",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la app duplicada conectada a esta base de datos"
    },
    "slug": {
      "type": "string",
      "description": "Identificador corto \u00fanico de la copia (ej: tlec-valencia)"
    },
    "contact_email": {
      "type": "string",
      "description": "Email de contacto del responsable de la copia"
    },
    "key_hash": {
      "type": "string",
      "description": "Hash SHA-256 de la clave de acceso de la copia. La clave nunca se guarda en claro."
    },
    "key_prefix": {
      "type": "string",
      "description": "Primeros caracteres de la clave, solo para identificarla en el panel"
    },
    "key_prefixes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "description": "Primeros caracteres de las claves anteriores de la copia, para poder atribuir llamadas rechazadas hechas con una clave ya rotada"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si est\u00e1 apagada, la copia no puede conectarse (sus llamadas reciben 'no autorizado')"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima llamada recibida desde esta copia"
    },
    "last_action": {
      "type": "string",
      "description": "\u00daltima acci\u00f3n procesada (recurso y operaci\u00f3n)"
    },
    "call_count": {
      "type": "number",
      "default": 0,
      "description": "Total de llamadas recibidas desde esta copia"
    },
    "report_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo reporte de estado que la copia envi\u00f3 al cerrar su ciclo de sincronizaci\u00f3n"
    },
    "report_configured": {
      "type": "boolean",
      "description": "Si la copia report\u00f3 tener guardados el enlace del servicio y su clave de acceso"
    },
    "report_missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Valores de conexi\u00f3n que a la copia le faltan guardar, seg\u00fan su \u00faltimo reporte"
    },
    "report_pending": {
      "type": "number",
      "default": 0,
      "description": "Env\u00edos pendientes que la copia ten\u00eda al cerrar su ciclo de sincronizaci\u00f3n"
    },
    "report_error": {
      "type": "string",
      "maxLength": 500,
      "description": "Motivo del \u00faltimo error de env\u00edo reportado por la copia"
    },
    "report_error_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo error de env\u00edo reportado por la copia"
    },
    "test_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que la copia ejecut\u00f3 y report\u00f3 su \u00faltima prueba de ida y vuelta"
    },
    "test_ok": {
      "type": "boolean",
      "description": "Resultado global de la \u00faltima prueba: verdadero solo si todos sus pasos pasaron"
    },
    "test_steps": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "description": "Identificador del paso: cliente, prealerta, factura o borrado"
          },
          "label": {
            "type": "string",
            "description": "Nombre visible del paso"
          },
          "ok": {
            "type": "boolean",
            "description": "Si el paso pas\u00f3"
          },
          "detail": {
            "type": "string",
            "maxLength": 300,
            "description": "Detalle del paso o motivo del fallo devuelto por TLEC CARGO"
          }
        },
        "required": [
          "step",
          "label",
          "ok"
        ]
      },
      "description": "Resultado paso por paso de la \u00faltima prueba de conexi\u00f3n"
    },
    "test_leftovers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "description": "Datos de prueba que la copia no pudo borrar y quedaron en TLEC CARGO"
    },
    "test_requested_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que un administrador pidi\u00f3 una prueba desde el diagn\u00f3stico. Se limpia cuando llega el resultado"
    },
    "test_requested_by": {
      "type": "string",
      "description": "Administrador que pidi\u00f3 la \u00faltima prueba"
    },
    "rejected_count": {
      "type": "number",
      "default": 0,
      "description": "Total de llamadas de esta copia rechazadas por TLEC CARGO (clave inv\u00e1lida o conexi\u00f3n desactivada)"
    },
    "rejected_last_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima llamada rechazada"
    },
    "rejected_last_reason": {
      "type": "string",
      "maxLength": 300,
      "description": "Motivo del \u00faltimo rechazo: clave no reconocida o copia desactivada"
    },
    "rejected_last_action": {
      "type": "string",
      "maxLength": 200,
      "description": "Operaci\u00f3n que tra\u00eda la \u00faltima llamada rechazada"
    },
    "created_by": {
      "type": "string",
      "description": "Admin que cre\u00f3 la conexi\u00f3n"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notas internas sobre esta copia"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "name",
    "slug",
    "key_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}