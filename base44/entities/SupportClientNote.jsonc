{
  "name": "SupportClientNote",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email del cliente al que pertenece la nota interna"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente (cache para mostrar en la ficha)"
    },
    "client_cedula": {
      "type": "string",
      "description": "C\u00e9dula del cliente (cache para mostrar en la ficha)"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID del ticket al que pertenece la nota. Vac\u00edo cuando es una nota general del cliente. Las notas de un caso quedan solo en el expediente de ese caso."
    },
    "ticket_number": {
      "type": "string",
      "description": "N\u00famero visible del ticket al que pertenece la nota (cache para mostrar)"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "nota",
        "indicacion"
      ],
      "default": "nota",
      "description": "nota: registro interno del equipo sobre la atenci\u00f3n. indicacion: orientaci\u00f3n de un supervisor para que el ATC sepa qu\u00e9 hacer con este cliente o con este caso."
    },
    "addressed_to": {
      "type": "string",
      "description": "A qui\u00e9n va dirigida la indicaci\u00f3n (ATC o \u00e1rea). Vac\u00edo en las notas del equipo."
    },
    "addressed_to_name": {
      "type": "string",
      "description": "Nombre con el que se muestra el destinatario de la indicaci\u00f3n"
    },
    "note": {
      "type": "string",
      "maxLength": 4000,
      "description": "Contenido de la nota interna. Nunca se env\u00eda ni se muestra al cliente: es contexto y registro del equipo."
    },
    "attachments": {
      "type": "array",
      "default": [],
      "description": "Fotos y documentos que acompa\u00f1an la nota o la indicaci\u00f3n. Los documentos y PDF van al almacenamiento privado y se abren con un enlace firmado temporal, para que no queden expuestos en una URL p\u00fablica.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Enlace de la foto o referencia del archivo privado"
          },
          "name": {
            "type": "string",
            "description": "Nombre del archivo"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "document"
            ],
            "description": "image para las fotos; document para PDF y documentos adjuntos"
          },
          "private": {
            "type": "boolean",
            "default": false,
            "description": "Indica que el archivo vive en el almacenamiento privado y requiere enlace firmado para abrirlo"
          }
        }
      }
    },
    "author_email": {
      "type": "string",
      "description": "Email del agente que escribi\u00f3 la nota"
    },
    "author_name": {
      "type": "string",
      "description": "Nombre del agente que escribi\u00f3 la nota"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "client_email",
    "note"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}