{
  "name": "Company",
  "type": "object",
  "properties": {
    "company_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de la empresa (TLEC para la casa matriz; c\u00f3digo corto en may\u00fasculas para cada socia). Se usa para sellar y separar los datos."
    },
    "name": {
      "type": "string",
      "description": "Nombre comercial de la empresa"
    },
    "legal_name": {
      "type": "string",
      "description": "Raz\u00f3n social de la empresa"
    },
    "contact_name": {
      "type": "string",
      "description": "Persona de contacto de la socia"
    },
    "contact_email": {
      "type": "string",
      "description": "Correo de contacto de la socia"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto de la socia"
    },
    "is_platform_owner": {
      "type": "boolean",
      "default": false,
      "description": "Marca la empresa due\u00f1a del sistema (TLEC). Solo esa empresa ve todos los datos."
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "suspendida",
        "desactivada"
      ],
      "default": "activa",
      "description": "Estado del acceso: solo activa permite leer o escribir por el canal de datos"
    },
    "config_key": {
      "type": "string",
      "description": "Clave de la fila de configuraci\u00f3n de esta empresa (main para TLEC, partner:C\u00d3DIGO para cada socia)"
    },
    "service_key": {
      "type": "string",
      "description": "Llave de servicio de la empresa. Autoriza el canal de datos de su app; TLEC puede verla, rotarla y cortarla."
    },
    "service_key_prefix": {
      "type": "string",
      "description": "Primeros caracteres de la llave, para reconocerla sin mostrarla completa"
    },
    "service_key_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de emisi\u00f3n de la llave"
    },
    "service_key_rotated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima rotaci\u00f3n de la llave"
    },
    "service_key_last_used_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que la app de la empresa us\u00f3 su llave"
    },
    "app_name": {
      "type": "string",
      "description": "Nombre que se muestra en la app de la socia"
    },
    "app_tagline": {
      "type": "string",
      "description": "Eslogan que se muestra en la app de la socia"
    },
    "app_logo_url": {
      "type": "string",
      "description": "URL del logo de la socia (1:1)"
    },
    "favicon_url": {
      "type": "string",
      "description": "URL del favicon de la app de la socia"
    },
    "brand_color": {
      "type": "string",
      "description": "Color de marca en hexadecimal (ej. #2563eb) para el distintivo de la app de la socia"
    },
    "app_public_url": {
      "type": "string",
      "description": "Enlace p\u00fablico de la app de la socia"
    },
    "custom_domain": {
      "type": "string",
      "description": "Dominio propio conectado a la app de la socia"
    },
    "invoice_company_name": {
      "type": "string",
      "description": "Nombre de la socia en sus facturas"
    },
    "invoice_company_address": {
      "type": "string",
      "description": "Direcci\u00f3n de la socia en sus facturas"
    },
    "invoice_company_city_zip": {
      "type": "string",
      "description": "Ciudad y c\u00f3digo postal de la socia en sus facturas"
    },
    "invoice_company_country": {
      "type": "string",
      "description": "Pa\u00eds de la socia en sus facturas"
    },
    "invoice_company_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de la socia en sus facturas"
    },
    "invoice_company_email": {
      "type": "string",
      "description": "Correo de la socia en sus facturas"
    },
    "invoice_logo_url": {
      "type": "string",
      "description": "Logo de la socia para sus facturas"
    },
    "app_built_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se cre\u00f3 o rehizo la app de la socia desde la versi\u00f3n actual de TLEC"
    },
    "activated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de alta de la empresa"
    },
    "disabled_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se cort\u00f3 el acceso de la empresa"
    },
    "created_by": {
      "type": "string",
      "description": "Email del administrador de TLEC que dio de alta la empresa"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas de la relaci\u00f3n comercial"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "company_code",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}