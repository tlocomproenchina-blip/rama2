{
  "name": "MasterSyncOutbox",
  "type": "object",
  "properties": {
    "resource": {
      "type": "string",
      "enum": [
        "health",
        "clients",
        "prealerts",
        "invoices",
        "payments",
        "bultos",
        "recibos"
      ],
      "description": "Qu\u00e9 se env\u00eda a TLEC CARGO: prueba de conexi\u00f3n, cliente registrado, pre-alerta, factura emitida, cobro registrado, bulto creado o recibo de CBM generado"
    },
    "record_id": {
      "type": "string",
      "description": "ID del registro local que origin\u00f3 el env\u00edo (usuario, paquete, factura, cobro, bulto o recibo)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Llave que evita duplicados: clients:<email>, prealerts:<tracking>, invoices:<numero>, payments:<id local>, bultos:<codigo de etiqueta>, recibos:<numero de orden> o health"
    },
    "label": {
      "type": "string",
      "description": "Etiqueta visible del env\u00edo (tracking, n\u00famero de factura, monto del cobro, c\u00f3digo del bulto, n\u00famero de orden, nombre o email del cliente)"
    },
    "payload": {
      "type": "object",
      "description": "Cuerpo exacto que se env\u00eda al servicio de TLEC CARGO"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "enviado",
        "error"
      ],
      "default": "pendiente",
      "description": "Estado del env\u00edo: pendiente, enviado o error (se reintenta)"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de intentos realizados"
    },
    "last_attempt_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo intento"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que TLEC CARGO acept\u00f3 el env\u00edo"
    },
    "last_error": {
      "type": "string",
      "maxLength": 500,
      "description": "Motivo del \u00faltimo error reportado por TLEC CARGO"
    },
    "master_response": {
      "type": "string",
      "maxLength": 300,
      "description": "Respuesta de TLEC CARGO: acci\u00f3n aplicada o nombre registrado de la copia"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "resource",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}