{
  "name": "Bulto",
  "type": "object",
  "properties": {
    "label_code": {
      "type": "string",
      "description": "C\u00f3digo escaneable de la etiqueta del bulto (shipping_mark-B##) o de la caja consolidada (shipping_mark-C##). Formato distinto al ShippingLabel (-L##) para evitar colisiones."
    },
    "is_caja": {
      "type": "boolean",
      "default": false,
      "description": "Marca que este registro es una caja consolidada: agrupa bultos peque\u00f1os (que se absorben dentro) y se despacha como una sola unidad, identificada con una etiqueta continua que lleva su c\u00f3digo de barras."
    },
    "caja_number": {
      "type": "number",
      "description": "Posici\u00f3n X de la caja dentro del lote del cliente (1..N). Se asigna al imprimir la tira de etiquetas continuas del lote y es la que se imprime como X/N en la etiqueta y en la gu\u00eda de despacho."
    },
    "caja_total": {
      "type": "number",
      "description": "Total N de cajas del lote del cliente al momento de imprimir la tira continua. Junto con caja_number forma el X/N de la etiqueta y de la gu\u00eda."
    },
    "caja_label_printed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se imprimi\u00f3 la etiqueta continua de esta caja."
    },
    "caja_label_printed_by": {
      "type": "string",
      "description": "Usuario o dispositivo que imprimi\u00f3 la etiqueta continua de la caja."
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente due\u00f1o de los paquetes agrupados en el bulto"
    },
    "shipping_mark": {
      "type": "string",
      "description": "Shipping mark del cliente al momento de crear el bulto"
    },
    "bulto_number": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero secuencial del bulto para ese cliente (1, 2, 3...)"
    },
    "total_bultos": {
      "type": "number",
      "default": 1,
      "description": "Total de bultos del env\u00edo/cliente. Se actualiza en cada bulto nuevo para que todos reflejen el total actual."
    },
    "package_ids": {
      "type": "array",
      "default": [],
      "description": "IDs de los Package agrupados f\u00edsicamente en este bulto (o dentro de la caja consolidada)",
      "items": {
        "type": "string"
      }
    },
    "package_trackings": {
      "type": "array",
      "default": [],
      "description": "Cache de tracking numbers de los paquetes contenidos (para mostrar al verificar sin reconsultar). Incluye tambi\u00e9n los c\u00f3digos sin registrar agregados al bulto.",
      "items": {
        "type": "string"
      }
    },
    "unregistered_codes": {
      "type": "array",
      "default": [],
      "description": "C\u00f3digos agregados al bulto (o caja) desde el escaneo del almac\u00e9n de Venezuela que no existen como Package en el sistema (etiqueta o tracking no registrado). No crean registros de paquetes: se imprimen en el bloque CONTENIDO de la etiqueta y cuentan como un paquete m\u00e1s en el conteo del bulto.",
      "items": {
        "type": "string"
      }
    },
    "cbm_order_numbers": {
      "type": "array",
      "default": [],
      "description": "N\u00fameros de orden de CbmIngreso (invoice_number) asociados a los trackings del bulto. Se calculan autom\u00e1ticamente por intersecci\u00f3n de tracking_numbers, o se ingresan manualmente al cerrar.",
      "items": {
        "type": "string"
      }
    },
    "absorbed_bultos": {
      "type": "array",
      "default": [],
      "description": "Historial de bultos absorbidos: cuando un paquete escaneado ya pertenec\u00eda a otro bulto (o cuando un bulto peque\u00f1o se mete dentro de una caja consolidada), ese bulto viejo se fusion\u00f3 aqu\u00ed (paquetes, c\u00f3digos sin registrar y N\u00b0 de orden) y se elimin\u00f3. Deja constancia de qu\u00e9 se movi\u00f3, cu\u00e1ndo y qui\u00e9n o qu\u00e9 dispositivo lo hizo.",
      "items": {
        "type": "object",
        "properties": {
          "label_code": {
            "type": "string",
            "description": "Etiqueta del bulto absorbido"
          },
          "bulto_number": {
            "type": "number"
          },
          "package_count": {
            "type": "number",
            "description": "Paquetes que tra\u00eda el bulto absorbido"
          },
          "order_numbers": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "N\u00b0 de orden CbmIngreso que tra\u00eda el bulto absorbido"
          },
          "status": {
            "type": "string",
            "description": "Estado que ten\u00eda el bulto absorbido al momento de la fusi\u00f3n"
          },
          "printed": {
            "type": "boolean",
            "default": false,
            "description": "Si su etiqueta ya hab\u00eda sido impresa cuando se absorbi\u00f3"
          },
          "invoice_number": {
            "type": "string",
            "description": "Factura en la que estaba incluido, si aplica"
          },
          "invoice_status": {
            "type": "string"
          },
          "guide_numbers": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Gu\u00edas de despacho donde estaba incluido, si aplica"
          },
          "trackings": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Trackings que tra\u00eda el bulto absorbido"
          },
          "absorbed_at": {
            "type": "string",
            "format": "date-time"
          },
          "absorbed_by": {
            "type": "string",
            "description": "Usuario o dispositivo del almac\u00e9n que absorbi\u00f3 el bulto"
          }
        }
      }
    },
    "cargo_cbm": {
      "type": "number",
      "description": "CBM oficial del bulto o de la caja consolidada, registrado o editado a mano por un admin desde 'Carga en almac\u00e9n' (Gesti\u00f3n de Facturas). Si est\u00e1 definido y es mayor a 0, manda sobre el CBM calculado y adem\u00e1s se escribi\u00f3 como volumen real (actual_cbm) de los paquetes del bulto."
    },
    "cargo_package_count": {
      "type": "number",
      "description": "Conteo real de paquetes del bulto o de la caja consolidada corregido por un admin desde 'Carga en almac\u00e9n'. Si est\u00e1 definido, manda sobre la cantidad deducida de package_ids o trackings, sin crear ni soltar paquetes escaneados; es el que se usa para facturar."
    },
    "cargo_risk_category": {
      "type": "string",
      "enum": [
        "general",
        "alto_riesgo"
      ],
      "description": "Tipo de carga con el que se registr\u00f3 la tarifa del bulto: general o alto riesgo. Si est\u00e1 vac\u00edo, se usa el detectado en sus paquetes."
    },
    "cargo_rate_per_cbm": {
      "type": "number",
      "description": "Tarifa por CBM aplicada al registrar la tarifa del bulto (USD/CBM). Queda en 0 cuando se aplic\u00f3 una tarifa especial por volumen."
    },
    "cargo_rate_kind": {
      "type": "string",
      "enum": [
        "estandar",
        "especial"
      ],
      "description": "Clase de tarifa registrada: estandar (CBM \u00d7 tarifa por CBM) o especial (monto fijo por volumen menor a 0.130 CBM)."
    },
    "cargo_amount": {
      "type": "number",
      "description": "Monto de env\u00edo registrado del bulto (USD), con la tarifa del estado del cliente, su CBM y su tipo de carga. La factura usa este monto tal cual, sin recalcularlo."
    },
    "cargo_updated_by": {
      "type": "string",
      "description": "Email del admin que registr\u00f3 o edit\u00f3 el CBM, el conteo de paquetes o la tarifa del bulto"
    },
    "cargo_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo registro o edici\u00f3n del CBM, del conteo de paquetes o de la tarifa del bulto"
    },
    "order_locked": {
      "type": "boolean",
      "default": false,
      "description": "Indica que el N\u00b0 de orden CbmIngreso ya fue asignado por un empleado desde la pantalla de escaneo. Bloquea la edici\u00f3n del campo por parte del empleado; solo un admin puede desbloquearlo (cambiar a false) desde BultoEditModal."
    },
    "order_assigned_by": {
      "type": "string",
      "description": "Email del empleado/admin que asign\u00f3 el N\u00b0 de orden desde la pantalla de escaneo"
    },
    "order_assigned_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que se asign\u00f3 el N\u00b0 de orden desde la pantalla de escaneo"
    },
    "ve_recognized_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el bulto fue reconocido en el almac\u00e9n de Venezuela al escanear su etiqueta (/BultoOrderScan). Marca la carga que ya lleg\u00f3 a Venezuela y alimenta el aviso diario al cliente."
    },
    "ve_recognized_by": {
      "type": "string",
      "description": "Usuario o dispositivo que reconoci\u00f3 el bulto en el almac\u00e9n de Venezuela"
    },
    "ve_notified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se avis\u00f3 al cliente que su bulto ya est\u00e1 en Venezuela (resumen diario). Evita repetir el email."
    },
    "recognition_photo_url": {
      "type": "string",
      "description": "Foto del bulto capturada autom\u00e1ticamente por el esc\u00e1ner al asignar el N\u00b0 de orden en el almac\u00e9n de Venezuela (/BultoOrderScan). Evidencia del bulto reconocido en destino."
    },
    "dispatch_photo_url": {
      "type": "string",
      "description": "Foto del bulto capturada autom\u00e1ticamente por el esc\u00e1ner al despacharlo desde el almac\u00e9n (/WarehouseDispatch). Evidencia de la salida de almac\u00e9n."
    },
    "client_snapshot": {
      "type": "object",
      "description": "Datos del cliente al momento de crear el bulto (para imprimir en la etiqueta)",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "cedula": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "shipping_mark": {
          "type": "string"
        }
      }
    },
    "invoice_paid": {
      "type": "boolean",
      "default": false,
      "description": "Snapshot: si la factura m\u00e1s reciente del cliente estaba pagada al crear el bulto"
    },
    "invoice_status": {
      "type": "string",
      "description": "Snapshot: estado de la factura m\u00e1s reciente (pendiente, pagada, etc.)"
    },
    "invoice_number": {
      "type": "string",
      "description": "Snapshot: n\u00famero de la factura de cobro m\u00e1s reciente"
    },
    "billed_invoice_id": {
      "type": "string",
      "description": "ID de la factura generada desde la pesta\u00f1a 'Carga en almac\u00e9n' de Gesti\u00f3n de Facturas o desde Facturaci\u00f3n Manual. Mientras esa factura exista, el bulto no vuelve a ofrecerse para facturar."
    },
    "billed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el bulto fue incluido en una factura desde la pesta\u00f1a 'Carga en almac\u00e9n'"
    },
    "billing_marked": {
      "type": "boolean",
      "default": false,
      "description": "Marca manual desde el panel de Facturaci\u00f3n Manual: el bulto y su N\u00b0 de orden/env\u00edo ya se facturaron (por fuera del sistema), as\u00ed que dejan de ofrecerse como carga pendiente de facturar."
    },
    "billing_marked_by": {
      "type": "string",
      "description": "Email del admin que marc\u00f3 a mano el bulto como ya facturado"
    },
    "billing_marked_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la marca manual de facturaci\u00f3n"
    },
    "storage_category": {
      "type": "string",
      "enum": [
        "estandar",
        "grande"
      ],
      "description": "Categor\u00eda de almacenamiento marcada a mano para el cargo diario de almacenamiento y custodia: estandar (USD 10 diarios) o grande (USD 20 diarios). Si est\u00e1 vac\u00eda se deduce de las medidas de sus paquetes y de las reglas configuradas."
    },
    "pallet_count": {
      "type": "number",
      "default": 0,
      "description": "Palets de carga consolidada que representa este bulto. Se usa para el recargo \u00fanico de montacargas (USD 150 por palet)."
    },
    "requiere_montacargas": {
      "type": "boolean",
      "default": false,
      "description": "Marca que este bulto necesita montacargas: sus palets pagan el recargo \u00fanico de USD 150 por cada palet, una sola vez."
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID del almac\u00e9n donde se empac\u00f3 el bulto"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "cerrado",
        "en_almacen_ve",
        "despachado"
      ],
      "default": "activo",
      "description": "Estado del bulto: activo (abierto, llen\u00e1ndose), cerrado (sellado, esperando despacho/impresi\u00f3n), en_almacen_ve (en almac\u00e9n de Venezuela, esperando despacho al cliente), despachado (entregado al transporte/cliente desde WarehouseDispatch)"
    },
    "print_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de impresiones de etiqueta. La primera impresi\u00f3n lo lleva a 1. M\u00e1ximo 3 reimpresiones antes de requerir aprobaci\u00f3n de admin."
    },
    "reprint_unlocked": {
      "type": "boolean",
      "default": false,
      "description": "Indica que un admin aprob\u00f3 una reimpresi\u00f3n extra tras alcanzar el l\u00edmite de 3. Permite una impresi\u00f3n adicional."
    },
    "created_by": {
      "type": "string",
      "description": "Email del admin que cre\u00f3 el bulto"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "label_code",
    "client_email",
    "shipping_mark"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}