{
  "name": "AssistedPaymentRequest",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email del cliente solicitante"
    },
    "request_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico de solicitud visible para cliente y admin (ej: AP-...)"
    },
    "submission_id": {
      "type": "string",
      "description": "Identificador que agrupa m\u00faltiples enlaces enviados en una misma solicitud"
    },
    "link_url": {
      "type": "string",
      "description": "Enlace de Alibaba, WeChat o Alipay"
    },
    "provider": {
      "type": "string",
      "enum": [
        "alibaba",
        "wechat",
        "alipay",
        "otro"
      ],
      "default": "otro",
      "description": "Plataforma del enlace"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Cantidad de unidades del producto"
    },
    "model_type": {
      "type": "string",
      "description": "Modelo o tipo del producto"
    },
    "product_image_url": {
      "type": "string",
      "description": "Foto del producto"
    },
    "amount": {
      "type": "number",
      "description": "Monto base a pagar (USD)"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "fee_percentage": {
      "type": "number",
      "description": "Porcentaje aplicado en el momento de la solicitud"
    },
    "fee_amount": {
      "type": "number",
      "description": "Monto de la comisi\u00f3n"
    },
    "total_amount": {
      "type": "number",
      "description": "Monto total a pagar (base + comisi\u00f3n)"
    },
    "image_url": {
      "type": "string",
      "description": "Soporte/imagen opcional"
    },
    "purchase_receipt_url": {
      "type": "string",
      "description": "Foto del comprobante de compra subida por el administrador"
    },
    "tracking_number": {
      "type": "string",
      "description": "N\u00famero de tracking cargado por el administrador cuando est\u00e1 disponible"
    },
    "tracking_prealerted": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se cre\u00f3 la pre-alerta autom\u00e1tica al cargar el tracking"
    },
    "notes": {
      "type": "string",
      "description": "Notas del cliente"
    },
    "admin_comment": {
      "type": "string",
      "description": "Comentario del administrador"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_proceso",
        "pagado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "reference": {
      "type": "string",
      "description": "Referencia o n\u00famero asociado"
    },
    "invoice_id": {
      "type": "string",
      "description": "ID de la factura generada (Invoice)"
    }
  },
  "required": [
    "client_email",
    "link_url",
    "amount"
  ]
}