{
  "name": "Quote",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Token \u00fanico para acceso p\u00fablico del cliente"
    },
    "quote_number": {
      "type": "string",
      "description": "N\u00famero visible del presupuesto (ej: PR-0001)"
    },
    "client_first_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "client_last_name": {
      "type": "string",
      "description": "Apellido del cliente"
    },
    "client_city": {
      "type": "string",
      "description": "Ciudad de despacho"
    },
    "client_phone": {
      "type": "string",
      "description": "N\u00famero de contacto (WhatsApp)"
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Productos del presupuesto",
      "items": {
        "type": "object",
        "properties": {
          "link": {
            "type": "string",
            "description": "Enlace del producto"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "image_url": {
            "type": "string",
            "description": "Imagen del art\u00edculo"
          },
          "size": {
            "type": "string",
            "description": "Talla o variante"
          },
          "unit_price": {
            "type": "number",
            "default": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY",
              "USD"
            ],
            "default": "CNY"
          },
          "subtotal": {
            "type": "number",
            "default": 0
          },
          "service_amount": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          },
          "total_usd": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "service_percentage": {
      "type": "number",
      "default": 15,
      "description": "Porcentaje de servicio a cobrar"
    },
    "conversion_rate": {
      "type": "number",
      "default": 0.15,
      "description": "Tasa de conversi\u00f3n \u00a5\u2192$ para este presupuesto"
    },
    "subtotal_cny": {
      "type": "number",
      "default": 0
    },
    "service_total_cny": {
      "type": "number",
      "default": 0
    },
    "total_cny": {
      "type": "number",
      "default": 0
    },
    "total_usd": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "esperando_cliente",
        "cliente_completo",
        "completado",
        "enviado"
      ],
      "default": "esperando_cliente",
      "description": "Estado del presupuesto"
    },
    "contract_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Si el cliente acept\u00f3 el contrato"
    },
    "contract_accepted_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Notas del cliente o admin"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email del admin que cre\u00f3 el presupuesto"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.token": "{{token}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.token": "{{token}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}