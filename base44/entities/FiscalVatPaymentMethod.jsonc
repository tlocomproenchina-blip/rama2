{
  "name": "FiscalVatPaymentMethod",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del m\u00e9todo"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "transferencia",
        "pago_movil",
        "zelle",
        "usdt",
        "paypal",
        "efectivo",
        "otro"
      ],
      "default": "transferencia"
    },
    "bank_platform": {
      "type": "string",
      "description": "Banco o plataforma"
    },
    "holder": {
      "type": "string",
      "description": "Titular o beneficiario"
    },
    "holder_id": {
      "type": "string",
      "description": "C\u00e9dula o RIF del titular"
    },
    "account_identifier": {
      "type": "string",
      "description": "Cuenta, tel\u00e9fono o direcci\u00f3n de pago"
    },
    "instructions": {
      "type": "string",
      "maxLength": 500
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Archivado cuando tiene pagos vinculados"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}