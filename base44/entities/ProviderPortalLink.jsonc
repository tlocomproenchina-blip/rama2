{
  "name": "ProviderPortalLink",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Clave secreta del enlace p\u00fablico del portal de proveedores"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si el enlace sigue funcionando (se desactiva al regenerarlo)"
    },
    "created_by": {
      "type": "string",
      "description": "Email del administrador que gener\u00f3 el enlace"
    },
    "access_password_hash": {
      "type": "string",
      "description": "Hash de la contrase\u00f1a de ingreso al portal (vac\u00edo = sin contrase\u00f1a)"
    },
    "access_password_salt": {
      "type": "string",
      "description": "Sal usada para el hash de la contrase\u00f1a"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}