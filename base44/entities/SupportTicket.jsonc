{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico del ticket"
    },
    "client_email": {
      "type": "string",
      "description": "Email del cliente que cre\u00f3 el ticket"
    },
    "subject": {
      "type": "string",
      "description": "Asunto del ticket"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierto",
        "en_proceso",
        "resuelto",
        "cerrado"
      ],
      "default": "abierto",
      "description": "Estado del ticket"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media",
      "description": "Prioridad del ticket"
    },
    "category": {
      "type": "string",
      "enum": [
        "pago",
        "envio",
        "tracking",
        "consolidacion",
        "actualizar_datos",
        "otro"
      ],
      "default": "otro",
      "description": "Categor\u00eda del ticket"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender_email": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "is_admin": {
            "type": "boolean"
          },
          "is_ai": {
            "type": "boolean",
            "default": false,
            "description": "Indica si el mensaje fue generado por el asistente IA"
          },
          "is_system": {
            "type": "boolean",
            "default": false,
            "description": "Indica si es un mensaje del sistema (ej: auto-cierre por inactividad)"
          },
          "attachments": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "Enlace de la foto o referencia del archivo privado (documentos y PDF se guardan en el almacenamiento privado y se abren con un enlace firmado)"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "document"
                  ],
                  "description": "image para las fotos; document para PDF y documentos adjuntos"
                },
                "private": {
                  "type": "boolean",
                  "default": false,
                  "description": "Indica que el archivo vive en el almacenamiento privado y requiere enlace firmado para abrirlo"
                }
              }
            }
          }
        }
      },
      "default": [],
      "description": "Historial de mensajes del ticket"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email del administrador asignado. En un caso escalado es el supervisor responsable."
    },
    "related_tracking": {
      "type": "string",
      "description": "N\u00famero de tracking relacionado si aplica"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de resoluci\u00f3n"
    },
    "escalated": {
      "type": "boolean",
      "default": false,
      "description": "Indica que el ATC escal\u00f3 este caso a un supervisor desde el Asistente ATC. Es lo que lo hace aparecer en la pesta\u00f1a Supervisor."
    },
    "escalation_status": {
      "type": "string",
      "enum": [
        "pendiente",
        "atendida"
      ],
      "default": "pendiente",
      "description": "Estado de la escalaci\u00f3n: pendiente (el supervisor todav\u00eda no la atendi\u00f3) o atendida (ya tom\u00f3 el caso). El historial se conserva en ambos casos."
    },
    "escalated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que el ATC escal\u00f3 el caso"
    },
    "escalated_by": {
      "type": "string",
      "description": "Email del ATC que escal\u00f3 el caso"
    },
    "escalated_by_name": {
      "type": "string",
      "description": "Nombre del ATC que escal\u00f3 el caso"
    },
    "escalation_summary": {
      "type": "string",
      "maxLength": 4000,
      "description": "Resumen del caso que el ATC deja al supervisor: qu\u00e9 est\u00e1 pasando, qu\u00e9 necesita y qu\u00e9 verificar"
    },
    "escalation_attended_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que el supervisor marc\u00f3 la escalaci\u00f3n como atendida"
    },
    "escalation_attended_by": {
      "type": "string",
      "description": "Email del supervisor que atendi\u00f3 la escalaci\u00f3n"
    },
    "escalation_attended_by_name": {
      "type": "string",
      "description": "Nombre del supervisor que atendi\u00f3 la escalaci\u00f3n"
    },
    "ai_escalated": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la IA escal\u00f3 el ticket a un agente humano"
    },
    "ai_pending_draft": {
      "type": "string",
      "description": "Borrador de respuesta generado por la IA, pendiente de revisi\u00f3n del admin"
    },
    "ai_draft_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que la IA gener\u00f3 el borrador pendiente"
    },
    "ai_feedback_buttons_shown": {
      "type": "boolean",
      "default": false,
      "description": "Indica si ya se mostraron los botones de feedback al cliente tras la \u00faltima respuesta de IA"
    },
    "ai_response_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp del \u00faltimo mensaje enviado por la IA (para calcular el cierre autom\u00e1tico)"
    },
    "auto_close_scheduled": {
      "type": "string",
      "format": "date-time",
      "description": "Momento programado para el cierre autom\u00e1tico (24h tras la \u00faltima respuesta de IA)"
    },
    "feedback_received": {
      "type": "string",
      "enum": [
        "positivo",
        "negativo"
      ],
      "description": "Feedback del cliente sobre la atenci\u00f3n recibida"
    },
    "auto_closed": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el ticket fue cerrado autom\u00e1ticamente por inactividad de 24h"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "client_email",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}