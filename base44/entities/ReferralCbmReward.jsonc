{
  "name": "ReferralCbmReward",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string"
    },
    "cbm_rewarded": {
      "type": "number"
    },
    "credit_generated": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "reversed"
      ],
      "default": "active"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "invoice_id",
    "referrer_user_id",
    "referred_user_id",
    "cbm_rewarded",
    "credit_generated"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}