    "battery_banner_end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin de la ventana del banner de bater\u00eda"
    },
    "battery_banner_title": {
      "type": "string",
      "default": "Contamos con toda la permisolog\u00eda para la importaci\u00f3n de bater\u00edas",
