    "battery_banner_html": {
      "type": "string",
      "default": "En TLEC CARGO estamos autorizados para gestionar la importaci\u00f3n de bater\u00edas de litio con todos los permisos y certificaciones vigentes. Tu carga viaja segura y cumpliendo con la normativa internacional.",
      "description": "Cuerpo HTML editable del banner de bater\u00eda"
    },
    "pwa_install_prompt_enabled": {
      "type": "boolean",
      "default": true,
