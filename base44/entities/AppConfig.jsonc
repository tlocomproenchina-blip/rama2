    },
    "client_hidden_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de p\u00e1ginas (page key) ocultas del men\u00fa lateral del cliente"
    },
    "battery_banner_enabled": {
      "type": "boolean",
      "default": false,
