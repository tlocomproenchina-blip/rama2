{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Unique config key"
    },
    "app_name": {
      "type": "string",
      "default": "TLEC CARGO",
      "description": "Nombre de la aplicaci\u00f3n que aparece en el sidebar"
    },
    "app_tagline": {
      "type": "string",
      "default": "Sistema de Env\u00edos",
      "description": "Eslogan que aparece en el sidebar"
    },
    "app_logo_url": {
      "type": "string",
      "description": "URL del logo de la aplicaci\u00f3n (1:1 ratio)"
    },
    "favicon_url": {
      "type": "string",
      "description": "URL del favicon/icono de pesta\u00f1a"
    },
    "warehouse_name": {
      "type": "string",
      "default": "Guangdong",
      "description": "Nombre del almac\u00e9n 1 mostrado al cliente"
    },
    "warehouse_address": {
      "type": "string"
    },
    "warehouse_phone": {
      "type": "string",
      "description": "N\u00famero telef\u00f3nico del almac\u00e9n 1"
    },
    "warehouse_zipcode": {
      "type": "string",
      "description": "C\u00f3digo postal del almac\u00e9n 1"
    },
    "warehouse2_name": {
      "type": "string",
      "default": "Yiwu",
      "description": "Nombre del almac\u00e9n 2 mostrado al cliente"
    },
    "warehouse2_address": {
      "type": "string",
      "description": "Direcci\u00f3n del almac\u00e9n 2 (Yiwu). Vac\u00edo = almac\u00e9n inactivo"
    },
    "warehouse2_phone": {
      "type": "string",
      "description": "N\u00famero telef\u00f3nico del almac\u00e9n 2"
    },
    "warehouse2_zipcode": {
      "type": "string",
      "description": "C\u00f3digo postal del almac\u00e9n 2"
    },
    "shipping_mark_example_image_url": {
      "type": "string",
      "description": "URL de imagen de ejemplo de c\u00f3mo debe quedar el shipping mark"
    },
    "shipping_mark_example_description": {
      "type": "string",
      "default": "Esta imagen se mostrar\u00e1 a los usuarios como ejemplo de c\u00f3mo debe quedar su shipping mark",
      "description": "Texto descriptivo que aparece junto a la imagen de ejemplo del Shipping Mark"
    },
    "shipping_mark_examples": {
      "type": "array",
      "description": "Ejemplos de Shipping Mark por plataforma (Pinduoduo, 1688, Taobao, etc.). Cada item tiene t\u00edtulo, imagen y descripci\u00f3n.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "T\u00edtulo de la plataforma (ej: Pinduoduo, 1688, Taobao, Alibaba, Tmall)"
          },
          "image_url": {
            "type": "string",
            "description": "URL de la imagen de ejemplo para esta plataforma"
          },
          "description": {
            "type": "string",
            "description": "Descripci\u00f3n del ejemplo para esta plataforma"
          }
        },
        "required": [
          "title"
        ]
      },
      "default": []
    },
    "contract_text": {
      "type": "string",
      "description": "Legal contract text"
    },
    "contract_file_url": {
      "type": "string",
      "description": "URL de archivo de contrato global (PDF o imagen) para presupuestos"
    },
    "quote_conversion_rate": {
      "type": "number",
      "default": 0.15,
      "description": "Tasa de conversi\u00f3n global \u00a5\u2192$ para presupuestos (1\u00a5 = X USD)"
    },
    "quote_fee_amount": {
      "type": "number",
      "default": 20,
      "description": "Monto de la tarifa por generar un presupuesto (USD)"
    },
    "quote_fee_enabled_methods": {
      "type": "array",
      "description": "M\u00e9todos de pago aceptados para la tarifa de presupuesto",
      "items": {
        "type": "string",
        "enum": [
          "paypal",
          "binance",
          "usdt_trc20",
          "transferencia",
          "wally",
          "zinli",
          "wise",
          "skrill",
          "pago_movil_usdt",
          "zelle",
          "otro"
        ]
      },
      "default": [
        "paypal"
      ]
    },
    "quote_fee_email_subject": {
      "type": "string",
      "default": "\ud83c\udf89 Tu enlace de presupuesto est\u00e1 listo",
      "description": "Asunto del email que recibe el cliente al verificarse el pago de la tarifa"
    },
    "quote_fee_email_body": {
      "type": "string",
      "default": "Hola {cliente_nombre},\n\n\u00a1Gracias por tu pago! Tu solicitud de presupuesto fue recibida.\n\nN\u00b0 de presupuesto: {numero_presupuesto}\n\nCompleta tus productos en el siguiente enlace:\n{enlace_presupuesto}\n\nTLEC CARGO",
      "description": "Cuerpo del email con el enlace del presupuesto. Placeholders: {cliente_nombre}, {numero_presupuesto}, {enlace_presupuesto}"
    },
    "rate_air_general": {
      "type": "number",
      "description": "Rate per kg for air general cargo"
    },
    "rate_air_sensitive": {
      "type": "number",
      "description": "Rate per kg for air sensitive cargo"
    },
    "rate_sea_general": {
      "type": "number",
      "description": "Rate per CBM for sea general cargo"
    },
    "rate_sea_sensitive": {
      "type": "number",
      "description": "Rate per CBM for sea sensitive cargo"
    },
    "insurance_percentage": {
      "type": "number",
      "description": "Insurance percentage of FOB"
    },
    "insurance_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "Cuando es true, el seguro de carga es obligatorio: el cliente debe ingresar el FOB y pagar el seguro antes de poder aprobar la pre-alerta."
    },
    "insurance_contract_text": {
      "type": "string",
      "description": "Texto del contrato espec\u00edfico de la aseguradora que el cliente debe aceptar al activar el seguro obligatorio."
    },
    "insurance_contract_file_url": {
      "type": "string",
      "description": "URL de archivo (PDF o imagen) del contrato de la aseguradora para descargar/ver."
    },
    "insurance_enabled_methods": {
      "type": "array",
      "description": "M\u00e9todos de pago aceptados espec\u00edficamente para el seguro de carga. Si est\u00e1 vac\u00edo, se usan todos los m\u00e9todos globales habilitados.",
      "items": {
        "type": "string",
        "enum": [
          "paypal",
          "binance",
          "usdt_trc20",
          "transferencia",
          "wally",
          "zinli",
          "wise",
          "skrill",
          "pago_movil_usdt",
          "zelle",
          "otro"
        ]
      },
      "default": []
    },
    "provider_rate_air_general": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por kg para carga a\u00e9rea general"
    },
    "provider_rate_air_sensitive": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por kg para carga a\u00e9rea sensible"
    },
    "provider_rate_sea_general": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por CBM para carga mar\u00edtima general"
    },
    "provider_rate_sea_sensitive": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por CBM para carga mar\u00edtima sensible (alto riesgo)"
    },
    "provider_insurance_percentage": {
      "type": "number",
      "default": 0,
      "description": "Porcentaje de seguro que cobra el proveedor sobre el FOB"
    },
    "provider_reception_fee": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por recepci\u00f3n de cada paquete"
    },
    "provider_door_to_door_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo del proveedor por servicio puerta a puerta"
    },
    "provider_special_cbm_rates": {
      "type": "array",
      "description": "Costos del proveedor por rango de CBM para cargas menores a 0.130 CBM",
      "items": {
        "type": "object",
        "properties": {
          "min_cbm": {
            "type": "number",
            "description": "CBM m\u00ednimo del rango (inclusive)"
          },
          "max_cbm": {
            "type": "number",
            "description": "CBM m\u00e1ximo del rango (inclusive)"
          },
          "rate_regular": {
            "type": "number",
            "description": "Costo del proveedor para carga regular en este rango"
          },
          "rate_high_risk": {
            "type": "number",
            "description": "Costo del proveedor para carga de alto riesgo en este rango"
          }
        },
        "required": [
          "min_cbm",
          "max_cbm",
          "rate_regular",
          "rate_high_risk"
        ]
      },
      "default": []
    },
    "special_cbm_rates": {
      "type": "array",
      "description": "Tarifas especiales por CBM para cargas menores a 0.130 CBM (llegan a Valencia, despacho MRW cobro destino)",
      "items": {
        "type": "object",
        "properties": {
          "min_cbm": {
            "type": "number",
            "description": "CBM m\u00ednimo del rango (inclusive)"
          },
          "max_cbm": {
            "type": "number",
            "description": "CBM m\u00e1ximo del rango (inclusive)"
          },
          "rate_regular": {
            "type": "number",
            "description": "Tarifa para carga regular en este rango de CBM"
          },
          "rate_high_risk": {
            "type": "number",
            "description": "Tarifa para carga de alto riesgo en este rango de CBM"
          }
        },
        "required": [
          "min_cbm",
          "max_cbm",
          "rate_regular",
          "rate_high_risk"
        ]
      },
      "default": [
        {
          "min_cbm": 0.0001,
          "max_cbm": 0.0025,
          "rate_regular": 3.6,
          "rate_high_risk": 5.4
        },
        {
          "min_cbm": 0.0026,
          "max_cbm": 0.007,
          "rate_regular": 11.4,
          "rate_high_risk": 17.4
        },
        {
          "min_cbm": 0.0071,
          "max_cbm": 0.015,
          "rate_regular": 24,
          "rate_high_risk": 36
        },
        {
          "min_cbm": 0.016,
          "max_cbm": 0.03,
          "rate_regular": 48,
          "rate_high_risk": 72
        },
        {
          "min_cbm": 0.031,
          "max_cbm": 0.06,
          "rate_regular": 72,
          "rate_high_risk": 120
        },
        {
          "min_cbm": 0.061,
          "max_cbm": 0.08,
          "rate_regular": 96,
          "rate_high_risk": 159.6
        },
        {
          "min_cbm": 0.09,
          "max_cbm": 0.129,
          "rate_regular": 102,
          "rate_high_risk": 204
        }
      ]
    },
    "invoice_company_name": {
      "type": "string",
      "default": "TLEC CARGO",
      "description": "Company name shown on invoices"
    },
    "invoice_company_tagline": {
      "type": "string",
      "default": "Sistema de Envios Internacionales",
      "description": "Tagline shown on invoices"
    },
    "invoice_company_address": {
      "type": "string",
      "description": "Direcci\u00f3n de la empresa que aparece en la factura PDF"
    },
    "invoice_company_city_zip": {
      "type": "string",
      "description": "Ciudad y c\u00f3digo postal de la empresa en la factura PDF"
    },
    "invoice_company_country": {
      "type": "string",
      "description": "Pa\u00eds de la empresa en la factura PDF"
    },
    "invoice_company_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de la empresa en la factura PDF"
    },
    "invoice_company_email": {
      "type": "string",
      "description": "Email de contacto de la empresa en la factura PDF"
    },
    "invoice_logo_url": {
      "type": "string",
      "description": "URL of company logo for invoices (1:1 ratio)"
    },
    "invoice_overdue_days": {
      "type": "number",
      "default": 7,
      "description": "N\u00famero de d\u00edas para considerar una factura vencida"
    },
    "payment_alert_days": {
      "type": "number",
      "default": 7,
      "description": "N\u00famero de d\u00edas para generar alertas de pagos pendientes"
    },
    "wallet_binance": {
      "type": "string"
    },
    "wallet_usdt_trc20": {
      "type": "string"
    },
    "binance_instructions": {
      "type": "string"
    },
    "usdt_instructions": {
      "type": "string"
    },
    "wallet_paypal": {
      "type": "string"
    },
    "paypal_instructions": {
      "type": "string"
    },
    "wallet_debito_internacional": {
      "type": "string"
    },
    "debito_internacional_instructions": {
      "type": "string"
    },
    "wallet_wally": {
      "type": "string"
    },
    "wally_instructions": {
      "type": "string"
    },
    "wallet_zinli": {
      "type": "string"
    },
    "zinli_instructions": {
      "type": "string"
    },
    "wallet_wise": {
      "type": "string"
    },
    "wise_instructions": {
      "type": "string"
    },
    "wallet_skrill": {
      "type": "string"
    },
    "skrill_instructions": {
      "type": "string"
    },
    "wallet_pago_movil_usdt": {
      "type": "string",
      "description": "DEPRECATED: Campo libre reemplazado por pago_movil_phone, pago_movil_bank, pago_movil_cedula. Se mantiene por compatibilidad."
    },
    "pago_movil_phone": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono para Pago M\u00f3vil (mostrado al cliente)"
    },
    "pago_movil_bank": {
      "type": "string",
      "description": "Banco para Pago M\u00f3vil (mostrado al cliente)"
    },
    "pago_movil_cedula": {
      "type": "string",
      "description": "C\u00e9dula para Pago M\u00f3vil (mostrado al cliente)"
    },
    "pago_movil_usdt_instructions": {
      "type": "string"
    },
    "bcv_eur_rate": {
      "type": "number",
      "default": 0,
      "description": "Tasa de cambio EUR\u2192VES del BCV (1 EUR = X Bs). Sincronizada autom\u00e1ticamente 6 veces al d\u00eda."
    },
    "bcv_eur_rate_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha efectiva de la tasa BCV (publicada por el BCV)"
    },
    "bcv_eur_rate_last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima sincronizaci\u00f3n de la tasa BCV"
    },
    "wallet_zelle": {
      "type": "string"
    },
    "zelle_instructions": {
      "type": "string"
    },
    "shipping_mark_prefix": {
      "type": "string",
      "default": "",
      "description": "Prefijo opcional para Shipping Mark (vac\u00edo para asignaci\u00f3n manual)"
    },
    "shipping_mark_auto_assign_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Habilita la asignaci\u00f3n autom\u00e1tica de Shipping Mark"
    },
    "shipping_mark_auto_assign_prefix": {
      "type": "string",
      "default": "TLEC-",
      "description": "Prefijo usado para generar Shipping Mark autom\u00e1tico"
    },
    "shipping_mark_auto_assign_length": {
      "type": "number",
      "default": 6,
      "description": "Longitud de la parte aleatoria del Shipping Mark autom\u00e1tico"
    },
    "shipping_mark_auto_assign_chars": {
      "type": "string",
      "default": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
      "description": "Caracteres permitidos para generar Shipping Mark autom\u00e1tico"
    },
    "consolidation_periods": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        15,
        20,
        30
      ],
      "description": "Per\u00edodos de consolidaci\u00f3n disponibles en d\u00edas"
    },
    "auto_consolidation_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activa o desactiva la consolidaci\u00f3n autom\u00e1tica de carga al vencer el per\u00edodo de espera"
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activar bot\u00f3n de soporte WhatsApp"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "N\u00famero de WhatsApp (sin + ni espacios, ej: 584121234567)"
    },
    "whatsapp_message": {
      "type": "string",
      "default": "Hola, necesito ayuda con mi env\u00edo",
      "description": "Mensaje predeterminado para WhatsApp"
    },
    "whatsapp_icon_url": {
      "type": "string",
      "description": "URL del icono personalizado para el bot\u00f3n WhatsApp"
    },
    "chatbot_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activar asistente virtual de atenci\u00f3n al cliente"
    },
    "ai_ticket_autoresponder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activar auto-respuesta de IA en tickets de soporte"
    },
    "ai_ticket_response_mode": {
      "type": "string",
      "enum": [
        "direct",
        "review"
      ],
      "default": "direct",
      "description": "Modo de respuesta: direct=env\u00edo autom\u00e1tico al cliente, review=borrador para aprobaci\u00f3n del admin"
    },
    "ai_reclaim_credits_used": {
      "type": "number",
      "default": 0,
      "description": "Contador de cr\u00e9ditos de integraci\u00f3n estimados gastados en el mes por aiReclaimOrphanPhotos (ruta Claude Sonnet v\u00eda InvokeLLM). Se resetea a 0 al cambiar de mes."
    },
    "ai_reclaim_monthly_budget": {
      "type": "number",
      "default": 200,
      "description": "Presupuesto mensual de cr\u00e9ditos de integraci\u00f3n para el reclamo IA de hu\u00e9rfanos. Al superar el 50% se conmuta a la ruta OpenAI directa (OPENAI_API_KEY) que no consume cr\u00e9ditos de integraci\u00f3n."
    },
    "ai_reclaim_counter_month": {
      "type": "string",
      "description": "Mes actual del contador (YYYY-MM). Si difiere del mes en curso, ai_reclaim_credits_used se resetea a 0."
    },
    "shipping_type_air_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar env\u00edo a\u00e9reo en el sistema"
    },
    "shipping_type_sea_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar env\u00edo mar\u00edtimo en el sistema"
    },
    "allow_profile_updates": {
      "type": "boolean",
      "default": true,
      "description": "Permitir que los clientes actualicen sus datos de perfil"
    },
    "payments_enable_binance": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_usdt_trc20": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_paypal": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_debito_internacional": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_wally": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_zinli": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_wise": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_skrill": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_pago_movil_usdt": {
      "type": "boolean",
      "default": true
    },
    "payments_enable_transferencia": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar Transferencia bancaria como m\u00e9todo de pago"
    },
    "maintenance_mode": {
      "type": "boolean",
      "default": false,
      "description": "Cerrar la aplicaci\u00f3n para usuarios (solo admins acceden)"
    },
    "maintenance_message": {
      "type": "string",
      "default": "Estamos realizando mantenimiento. Por favor, int\u00e9ntalo m\u00e1s tarde.",
      "description": "Mensaje mostrado en la pantalla de mantenimiento"
    },
    "maintenance_image_url": {
      "type": "string",
      "description": "Imagen a mostrar en la pantalla de mantenimiento"
    },
    "admin_dashboard_prefs": {
      "type": "object",
      "description": "Preferencias globales del dashboard de administrador",
      "properties": {
        "showClients": {
          "type": "boolean",
          "default": true
        },
        "showPackages": {
          "type": "boolean",
          "default": true
        },
        "showStatusPie": {
          "type": "boolean",
          "default": true
        },
        "showRecent": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "payments_assisted_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar Pago Asistido"
    },
    "payments_assisted_fee_percentage": {
      "type": "number",
      "default": 5,
      "description": "Porcentaje de comisi\u00f3n para Pago Asistido"
    },
    "payments_assisted_instructions": {
      "type": "string",
      "description": "Instrucciones visibles para Pago Asistido"
    },
    "demo_mode": {
      "type": "boolean",
      "default": false,
      "description": "Modo demo: desactiva integraciones externas (PayPal, emails, push, webhooks)"
    },
    "demo_mode_message": {
      "type": "string",
      "default": "Modo demo activo: integraciones externas desactivadas.",
      "description": "Mensaje mostrado cuando el modo demo est\u00e1 activo"
    },
    "activity_tracking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activar el rastreo de actividad de empleados (consume llamadas a funciones por cada navegaci\u00f3n)"
    },
    "logistics_monitoring_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activar el monitoreo autom\u00e1tico del m\u00f3dulo log\u00edstico (cada hora). Desact\u00edvalo si no usas rutas y veh\u00edculos."
    },
    "emails_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Kill switch global de emails. Si est\u00e1 apagado, NINGUNA funci\u00f3n de backend enviar\u00e1 emails (solo notificaciones in-app)."
    },
    "logistics_emails_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Permite que los cambios de Ruta, Veh\u00edculo, Chofer y Seguimiento env\u00eden emails."
    },
    "brevo_daily_limit": {
      "type": "number",
      "default": 295,
