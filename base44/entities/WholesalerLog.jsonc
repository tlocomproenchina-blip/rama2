{
  "name": "WholesalerLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "cliente_pendiente",
        "cliente_nuevo",
        "cliente_existente",
        "cliente_error",
        "prealerta_reportada",
        "prealerta_duplicada",
        "prealerta_rechazada",
        "recepcion",
        "recepcion_existente",
        "no_registrado",
        "consulta",
        "aviso_enviado",
        "aviso_fallido",
        "informe_enviado",
        "informe_fallido",
        "sync_fallido",
        "conexion_fallida",
        "conexion_ok"
      ],
      "description": "Tipo de movimiento del intercambio con la app del mayorista"
    },
    "wholesaler_key": {
      "type": "string",
      "description": "Clave de la conexi\u00f3n (WholesalerSync.config_key) del mayorista involucrado. Vac\u00edo en los movimientos anteriores a admitir varios mayoristas: cuentan como de la conexi\u00f3n principal."
    },
    "wholesaler_name": {
      "type": "string",
      "description": "Nombre del mayorista involucrado (cache para mostrar y filtrar)"
    },
    "tracking_number": {
      "type": "string",
      "description": "Tracking involucrado en el movimiento"
    },
    "client_email": {
      "type": "string"
    },
    "shipping_mark": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "description": "ID del paquete involucrado, si aplica"
    },
    "result": {
      "type": "string",
      "description": "Resultado corto del movimiento (recibido, ya_registrado, duplicado, enviado, fallido\u2026)"
    },
    "detail": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detalle del movimiento: motivo, mensaje de error o nota"
    },
    "source_app": {
      "type": "string",
      "default": "mayorista",
      "description": "App de origen del movimiento: la app del cliente mayorista"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del movimiento: es la fecha con la que se ordena el historial"
    },
    "notify_pending": {
      "type": "boolean",
      "default": false,
      "description": "Recepci\u00f3n que todav\u00eda no se ha podido avisar a la app del mayorista, o cuyo aviso sali\u00f3 sin la foto de la carga y falta completarlo."
    },
    "notify_attempts": {
      "type": "number",
      "default": 0,
      "description": "Intentos de aviso realizados para esta recepci\u00f3n"
    },
    "notified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que el aviso de esta recepci\u00f3n se entreg\u00f3 al mayorista"
    },
    "photo_pending": {
      "type": "boolean",
      "default": false,
      "description": "El aviso de esa recepci\u00f3n sali\u00f3 al mayorista sin la foto de la carga que captura TLEC CARGO en el almac\u00e9n: queda pendiente enviarla en cuanto exista. Mientras est\u00e9 en true, el aviso no se da por completo y la foto se manda en el env\u00edo o reintento siguiente."
    },
    "notify_history": {
      "type": "array",
      "default": [],
      "description": "Cada intento de entrega del aviso de esta recepci\u00f3n a la app del mayorista: cu\u00e1ndo, con qu\u00e9 resultado, el motivo cuando fall\u00f3 y cu\u00e1ntas fotos de la carga iban en ese env\u00edo. Es lo que muestra el historial de env\u00edos del panel.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Momento del intento"
          },
          "result": {
            "type": "string",
            "enum": [
              "enviado",
              "fallido"
            ],
            "description": "Resultado del intento"
          },
          "detail": {
            "type": "string",
            "maxLength": 300,
            "description": "Detalle o motivo del intento"
          },
          "fotos_count": {
            "type": "number",
            "description": "Fotos de la carga que se enviaron en este intento"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descripci\u00f3n opcional"
    }
  },
  "required": [
    "event_type",
    "event_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}