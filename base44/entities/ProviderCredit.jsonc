{
  "name": "ProviderCredit",
  "type": "object",
  "properties": {
    "provider_name": {
      "type": "string",
      "description": "Nombre del proveedor"
    },
    "provider_id": {
      "type": "string",
      "description": "ID del proveedor (ShippingProvider) si aplica"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura del proveedor"
    },
    "invoice_amount": {
      "type": "number",
      "description": "Monto de la factura (lo que se deb\u00eda pagar)"
    },
    "paid_amount": {
      "type": "number",
      "description": "Monto realmente pagado al proveedor"
    },
    "credit_amount": {
      "type": "number",
      "description": "Monto a favor = paid_amount - invoice_amount (sobre pago)"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del pago"
    },
    "invoice_image_url": {
      "type": "string",
      "description": "URL de la foto de la factura del proveedor (ImgBB)"
    },
    "receipt_image_url": {
      "type": "string",
      "description": "URL de la foto del comprobante de pago (ImgBB)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "usado"
      ],
      "default": "disponible",
      "description": "Si el saldo a favor ya fue usado o sigue disponible"
    },
    "used_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se marc\u00f3 como usado"
    },
    "used_description": {
      "type": "string",
      "description": "Descripci\u00f3n de en qu\u00e9 se us\u00f3 el saldo a favor"
    },
    "used_amount": {
      "type": "number",
      "default": 0,
      "description": "Monto del saldo a favor que se us\u00f3 (parcial o total)"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email del administrador que registr\u00f3 el movimiento"
    }
  },
  "required": [
    "provider_name",
    "invoice_amount",
    "paid_amount",
    "credit_amount",
    "payment_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}