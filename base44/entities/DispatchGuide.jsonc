{
  "name": "DispatchGuide",
  "type": "object",
  "properties": {
    "guide_number": {
      "type": "string",
      "description": "N\u00famero correlativo visible de la gu\u00eda de despacho (ej: GD-00001)"
    },
    "guide_sequence": {
      "type": "number",
      "description": "N\u00famero secuencial interno con el que se asign\u00f3 el consecutivo"
    },
    "emitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que se emiti\u00f3 la gu\u00eda. Es la fecha que se imprime al reimprimirla."
    },
    "emitted_by": {
      "type": "string",
      "description": "Email del usuario que emiti\u00f3 la gu\u00eda"
    },
    "emitted_by_name": {
      "type": "string",
      "description": "Nombre del usuario que emiti\u00f3 la gu\u00eda"
    },
    "auto_generated": {
      "type": "boolean",
      "default": false,
      "description": "Indica que la gu\u00eda se arm\u00f3 sola al escanear las cajas y bultos en Despacho por Escaneo (una gu\u00eda abierta por cliente) y no desde la emisi\u00f3n manual."
    },
    "source": {
      "type": "string",
      "enum": [
        "periodo_pagos",
        "escaneo",
        "lote_etiquetas",
        "manual"
      ],
      "description": "Origen de la gu\u00eda: periodo_pagos (generada desde el per\u00edodo de facturas pagadas), escaneo (abierta por el esc\u00e1ner de despacho), lote_etiquetas (emitida al imprimir el lote de etiquetas) o manual (emitida eligiendo a mano el cliente y sus bultos, sus \u00f3rdenes/env\u00edos o las \u00f3rdenes de una factura pagada)."
    },
    "period_key": {
      "type": "string",
      "description": "Clave del per\u00edodo de pagos del que sali\u00f3 la gu\u00eda (desde_hasta). Marca las gu\u00edas de un mismo per\u00edodo para no volver a generarlas ni duplicarlas."
    },
    "last_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo bulto o caja sumado a la gu\u00eda. En una gu\u00eda autom\u00e1tica se actualiza con cada bloque escaneado del mismo cliente."
    },
    "last_updated_by": {
      "type": "string",
      "description": "Email del usuario o dispositivo que sum\u00f3 el \u00faltimo bloque a la gu\u00eda"
    },
    "filter_from": {
      "type": "string",
      "description": "Fecha inicial del rango de escaneos usado al armar la gu\u00eda"
    },
    "filter_to": {
      "type": "string",
      "description": "Fecha final del rango de escaneos usado al armar la gu\u00eda"
    },
    "clients": {
      "type": "array",
      "default": [],
      "description": "Snapshot completo del contenido de la gu\u00eda, agrupado por cliente, tal como se emiti\u00f3. Se usa para reimprimir la gu\u00eda sin recalcular nada.",
      "items": {
        "type": "object",
        "properties": {
          "client_key": {
            "type": "string"
          },
          "client_email": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "shipping_mark": {
            "type": "string"
          },
          "orders_count": {
            "type": "number"
          },
          "client": {
            "type": "object",
            "properties": {
              "full_name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "cedula": {
                "type": "string"
              },
              "whatsapp": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "shipping_mark": {
                "type": "string"
              }
            }
          },
          "bultos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label_code": {
                  "type": "string",
                  "description": "C\u00f3digo de etiqueta del bulto o de la caja. Va vac\u00edo en una l\u00ednea de carga sin bulto registrado (la que se emite por N\u00b0 de orden / env\u00edo)."
                },
                "package_count": {
                  "type": "number"
                },
                "registered": {
                  "type": "boolean"
                },
                "unregistered": {
                  "type": "boolean",
                  "default": false,
                  "description": "Indica que esta l\u00ednea de la gu\u00eda es carga despachada por su N\u00b0 de orden / env\u00edo sin bulto registrado (el bulto no se cre\u00f3 o no existe): no tiene c\u00f3digo de etiqueta y se imprime como carga sin bulto."
                },
                "date": {
                  "type": "string"
                },
                "order_number": {
                  "type": "string"
                },
                "invoice_number": {
                  "type": "string",
                  "description": "N\u00b0 de la factura (Invoice) de la que sali\u00f3 esta orden / env\u00edo, cuando se emiti\u00f3 desde una factura pagada."
                },
                "tracking_numbers": {
                  "type": "array",
                  "default": [],
                  "description": "Trackings del recibo de carga que respalda esta l\u00ednea sin bulto registrado. Se usan como paquetes de la orden de despacho.",
                  "items": {
                    "type": "string"
                  }
                },
                "scans": {
                  "type": "number"
                },
                "is_caja": {
                  "type": "boolean",
                  "description": "Indica que esta l\u00ednea de la gu\u00eda es una caja consolidada (etiqueta continua) y no un bulto suelto."
                },
                "caja_number": {
                  "type": "number",
                  "description": "Posici\u00f3n X de la caja dentro del lote del cliente, tal como qued\u00f3 impresa en su etiqueta continua."
                },
                "caja_total": {
                  "type": "number",
                  "description": "Total N de cajas del lote del cliente, tal como qued\u00f3 impreso en la etiqueta continua."
                },
                "cbm": {
                  "type": "number",
                  "description": "CBM oficial de la caja o del bulto al momento de armar la gu\u00eda."
                }
              }
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "bultos": {
                "type": "number",
                "description": "L\u00edneas de la gu\u00eda para ese cliente: bultos y cajas m\u00e1s las l\u00edneas sin bulto registrado."
              },
              "packages": {
                "type": "number"
              },
              "unregistered": {
                "type": "number",
                "description": "Cu\u00e1ntas de esas l\u00edneas son carga sin bulto registrado"
              },
              "scanned": {
                "type": "number"
              },
              "cajas": {
                "type": "number"
              },
              "cbm": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "client_names": {
      "type": "array",
      "default": [],
      "description": "Nombres de los clientes incluidos (para buscar en el historial)",
      "items": {
        "type": "string"
      }
    },
    "client_emails": {
      "type": "array",
      "default": [],
      "description": "Emails de los clientes incluidos (para buscar en el historial y para encontrar la gu\u00eda abierta del cliente)",
      "items": {
        "type": "string"
      }
    },
    "shipping_marks": {
      "type": "array",
      "default": [],
      "description": "Shipping marks incluidos (para buscar en el historial y para encontrar la gu\u00eda abierta del cliente cuando el escaneo no trae email)",
      "items": {
        "type": "string"
      }
    },
    "bulto_codes": {
      "type": "array",
      "default": [],
      "description": "C\u00f3digos de bulto y de caja incluidos en la gu\u00eda. Marcan los escaneos que ya no vuelven a ofrecerse como pendientes.",
      "items": {
        "type": "string"
      }
    },
    "unregistered_order_keys": {
      "type": "array",
      "default": [],
      "description": "Claves (email del cliente + N\u00b0 de orden / env\u00edo) de la carga despachada sin bulto registrado que entr\u00f3 en esta gu\u00eda. Marca esas \u00f3rdenes para no volver a ofrecerlas y para saber en qu\u00e9 gu\u00eda sali\u00f3 cada una.",
      "items": {
        "type": "string"
      }
    },
    "totals": {
      "type": "object",
      "description": "Totales de la gu\u00eda al momento de emitirla",
      "properties": {
        "clients": {
          "type": "number"
        },
        "bultos": {
          "type": "number",
          "description": "L\u00edneas de la gu\u00eda: bultos y cajas m\u00e1s las l\u00edneas sin bulto registrado."
        },
        "packages": {
          "type": "number"
        },
        "unregistered": {
          "type": "number",
          "description": "Cu\u00e1ntas de esas l\u00edneas son carga sin bulto registrado, emitida por su N\u00b0 de orden / env\u00edo."
        },
        "cajas": {
          "type": "number",
          "description": "Cantidad de cajas consolidadas incluidas en la gu\u00eda"
        },
        "cbm": {
          "type": "number",
          "description": "CBM total de las cajas y bultos de la gu\u00eda"
        }
      }
    },
    "dispatch_orders": {
      "type": "array",
      "default": [],
      "description": "\u00d3rdenes de despacho que se generaron solas al emitir la gu\u00eda a mano: una por cliente, con su n\u00famero de orden y cu\u00e1ntas l\u00edneas y paquetes cubre. Es el resumen con el que el historial muestra la gu\u00eda junto con sus \u00f3rdenes.",
      "items": {
        "type": "object",
        "properties": {
          "client_email": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "shipping_mark": {
            "type": "string"
          },
          "order_id": {
            "type": "string",
            "description": "ID de la orden de despacho creada (DispatchOrder)"
          },
          "order_number": {
            "type": "string",
            "description": "N\u00famero visible de la orden de despacho (OD-AAAAAMMDD-####)"
          },
          "bultos_count": {
            "type": "number",
            "description": "L\u00edneas de la gu\u00eda que cubre esa orden (bultos, cajas y carga sin bulto registrado)"
          },
          "packages_count": {
            "type": "number",
            "description": "Paquetes sumados de esas l\u00edneas"
          },
          "cbm": {
            "type": "number",
            "description": "CBM sumado de esas l\u00edneas"
          },
          "emitted_by": {
            "type": "string",
            "description": "Email del admin que emiti\u00f3 la gu\u00eda y gener\u00f3 la orden"
          }
        }
      }
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "emitida",
        "entregada"
      ],
      "default": "emitida",
      "description": "Estado de entrega de la gu\u00eda: emitida (impresa, pendiente de entrega) o entregada (entrega anotada). Una gu\u00eda emitida sigue abierta: los bloques que se escaneen despu\u00e9s para ese cliente se suman a ella."
    },
    "delivered_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se entreg\u00f3 la carga de esta gu\u00eda"
    },
    "received_by": {
      "type": "string",
      "description": "Nombre de quien recibi\u00f3 la carga"
    },
    "delivery_notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notas de la entrega"
    },
    "delivery_updated_by": {
      "type": "string",
      "description": "Email del usuario que anot\u00f3 o corrigi\u00f3 la entrega"
    },
    "delivery_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima anotaci\u00f3n de entrega"
    },
    "dispatch_due_date": {
      "type": "string",
      "format": "date",
      "description": "S\u00e1bado inmediato posterior a la emisi\u00f3n de la gu\u00eda: ese d\u00eda (contando el s\u00e1bado, hora de Caracas) la gu\u00eda se marca despachada y con ella sus bultos y contenedores. Se guarda al emitir la gu\u00eda; en las gu\u00edas anteriores a la regla se completa al pasar la revisi\u00f3n autom\u00e1tica."
    },
    "dispatch_due_completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que la revisi\u00f3n autom\u00e1tica marc\u00f3 despachados los bultos y contenedores de la gu\u00eda. Vac\u00edo mientras el s\u00e1bado l\u00edmite no se haya alcanzado."
    },
    "dispatch_due_bultos": {
      "type": "number",
      "description": "Bultos que quedaron marcados como despachados la primera vez que la revisi\u00f3n autom\u00e1tica proces\u00f3 la gu\u00eda"
    },
    "dispatch_due_containers": {
      "type": "number",
      "description": "Contenedores (recibos de carga) que quedaron marcados como despachados la primera vez que la revisi\u00f3n autom\u00e1tica proces\u00f3 la gu\u00eda"
    }
  },
  "required": [
    "guide_number",
    "emitted_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}