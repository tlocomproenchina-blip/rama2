{
  "description": "Avisos de cobro seg\u00fan los T\u00e9rminos (secci\u00f3n VII): cada d\u00eda a las 08:00 de Caracas, las facturas impagas que est\u00e1n exactamente en el d\u00eda 5, 7, 8, 14, 20, 22, 25 o 26 desde su emisi\u00f3n reciben el correo y la notificaci\u00f3n de esa etapa, una sola vez. Se detienen al pagar.",
  "name": "Notificaciones de Almacenamiento Autom\u00e1ticas",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificaciones_de_almacenamiento_autom_ticas",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendStorageNotifications",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar avisos de cobro del d\u00eda",
            "description": "Correo y notificaci\u00f3n por etapa"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Caracas",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendStorageNotifications"
  }
}