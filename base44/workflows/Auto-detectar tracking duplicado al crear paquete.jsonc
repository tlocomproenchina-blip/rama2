{
  "name": "Auto-detectar tracking duplicado al crear paquete",
  "description": "Detecta autom\u00e1ticamente si un paquete nuevo tiene un tracking duplicado y notifica a los admins",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Package"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_detectar_tracking_duplicado_al_crear_paquete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCheckDuplicates",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCheckDuplicates"
  }
}