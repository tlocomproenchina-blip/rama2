{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 16,17,18,19,20,21 * * *",
      "one_time_date": null,
      "timezone": "America/Caracas",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "bcv_eur_rate_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_rate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBcvEurRate"
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar tasa EUR BCV",
            "description": "Fetch y guardado en AppConfig"
          }
        }
      }
    ]
  },
  "name": "BCV EUR Rate Sync",
  "description": "Sincroniza la tasa EUR del BCV 6 veces al d\u00eda (16:00-21:00 hora Caracas) para mostrar montos en Bol\u00edvares a los clientes"
}