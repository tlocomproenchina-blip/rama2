{
  "name": "Auto-formato Shipping Mark - CbmIngreso",
  "description": "Normaliza shipping_mark sin guiones en ingresos CBM al crear/actualizar.",
  "trigger": {
    "condition": "${ ((.trigger.data.shipping_mark | startswith(\"N\")) and (.trigger.data.shipping_mark | index(\"TLEC\") != null) and (.trigger.data.shipping_mark | index(\"-\") == null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "CbmIngreso"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_formato_shipping_mark_cbmingreso",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "normalizeShippingMarkOnChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "normalizeShippingMarkOnChange"
  }
}